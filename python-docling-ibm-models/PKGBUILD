# Maintainer: @RubenKelevra <rubenkelevra@gmail.com>
# Contributor: Majorx234 <majorx234@gmail.com>

_pkgname='docling-ibm-models'
pkgname="python-${_pkgname}"
pkgver='4.0.2'
pkgrel=2
pkgdesc='AI models used by the Docling PDF conversion package'
arch=('any')
url="https://github.com/docling-project/${_pkgname}"
license=('MIT')
depends=(
  'python>=3.10'
  'python-pytorch>=2.2.2'
  'python-torchvision'
  'python-pillow>=10.0.0'
  'python-huggingface-hub>=0.23.0'
  'python-safetensors>=0.4.3'
  # Unversioned on purpose: python-transformers-git declares a bare
  # 'Provides: python-transformers' with no version, and pacman will not
  # match an unversioned provide against a versioned dependency -- so
  # '>=4.42.0' fails both makepkg's dep check and 'pacman -U' on this
  # system despite transformers 5.13.0.dev0 being installed and well
  # inside upstream's '>=4.42.0,<6.0.0' range.
  'python-transformers'
  'python-numpy>=1.24.4'
)
# The dependency above is unversioned, which drops upstream's
# 'transformers <6.0.0' ceiling as well as its floor. Restore the ceiling
# here: a versioned conflict does not match python-transformers-git's bare
# provide, so it constrains only a real versioned provider.
conflicts=(
  'python-transformers=5.13.0'
  'python-transformers<4.42.0'
  'python-transformers>=6.0.0'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
checkdepends=(
  'python-pytest'
  'python-opencv>=4.6.0'
)
optdepends=(
  # Upstream tests opencv-python only in >=4.6.0.66,<5.0.0.0. Written as
  # '<5', not as a literal transliteration of that bound: PEP 440 treats
  # 5.0.0 and 5.0.0.0 as equal, but pacman's vercmp ranks 5.0.0 BELOW
  # 5.0.0.0, so '<5.0.0.0' would admit the very 5.0.0 upstream excludes.
  # Arch's python-opencv is 5.x and no packaged provider of this name is in
  # range, so this reports unsatisfied rather than implying untested support.
  'python-opencv<5: legacy TableFormer image preprocessing'
)
source=("${_pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
b2sums=('e4e1e743e7178e5474d1dcfd2c46d01b0a6404b4c54449730ca46f24ca4147fd1f13b748c83c97fd0783378b5ee775bd2ed252406d4ac464833f6bd808260d53')

build() {
  cd -- "${_pkgname}-${pkgver}" || return 1
  python -m build --wheel --no-isolation
}

check() {
  cd -- "${_pkgname}-${pkgver}" || return 1
  HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 python -m pytest -q \
    tests/test_common.py \
    tests/test_matching_post_processor.py \
    tests/test_matching_post_processor_orphans.py \
    tests/test_tf_predictor_indexes.py
}

package() {
  cd -- "${_pkgname}-${pkgver}" || return 1
  # --compile-bytecode is argparse action="append": passing only "2" REPLACES
  # the [0, 1] default, shipping .opt-2.pyc and no plain .pyc, so ordinary
  # (non -OO) imports find no cached bytecode under read-only /usr/lib and
  # recompile on every interpreter start. Ship the Arch-standard 0 and 1.
  python -m installer --destdir="${pkgdir}" \
    --compile-bytecode 0 --compile-bytecode 1 \
    dist/*.whl
  install -D -m644 -- LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

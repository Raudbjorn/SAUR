--- a/src/trailmark/analysis/proxies.py
+++ b/src/trailmark/analysis/proxies.py
@@ -5,7 +5,7 @@ from __future__ import annotations
 import dataclasses
 import re
 
-from trailmark.models.edges import CodeEdge, EdgeKind
+from trailmark.models.edges import CodeEdge, EdgeConfidence, EdgeKind
 from trailmark.models.graph import CodeGraph
 from trailmark.models.nodes import CodeUnit, NodeKind, NodeOrigin, SourceLocation, TypeRef
 
@@ -21,9 +21,140 @@ def ensure_proxy_nodes(graph: CodeGraph) -> CodeGraph:
     """
     _materialize_unresolved_calls(graph)
     _materialize_type_use_edges(graph)
+    resolve_proxy_calls(graph)
+    # Cross-file resolution. Imported here rather than at module scope because
+    # `analysis.inheritance` is a sibling pass and a top-level import would make the
+    # import order between the two passes look load-bearing when it is not.
+    from trailmark.analysis.inheritance import resolve_inherited_state, resolve_inherits_edges
+
+    # Order matters: inherited-state resolution walks the inheritance graph, so the
+    # dangling inherits edges must be repaired first.
+    from trailmark.analysis.storage_pointers import resolve_storage_pointer_writes
+
+    resolve_inherits_edges(graph)
+    resolve_inherited_state(graph)

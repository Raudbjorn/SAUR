+    @property
+    def graph(self) -> CodeGraph:
+        """The underlying graph. Read-only by convention.
+
+        Public because consumers legitimately need to enumerate nodes and edges, and
+        the alternative was every caller writing ``store._graph`` -- or worse,
+        ``engine._store._graph`` from outside the package entirely. A private attribute
+        that everybody reaches through is not encapsulation; it is an undocumented API
+        with no compatibility promise, which is precisely how the query surfaces drifted
+        apart. Mutating the returned graph invalidates the rustworkx indexes; call
+        ``rebuild_index()`` afterwards.
+        """
+        return self._graph
+
     def rebuild_index(self) -> None:
         """Rebuild all rustworkx indexes after graph nodes or edges change."""
         self._digraph: rx.PyDiGraph[str, CodeEdge] = rx.PyDiGraph()

index 9bee8a8..8bd0a67 100644
--- a/tests/test_solidity_parser.py
+++ b/tests/test_solidity_parser.py
@@ -309,3 +309,67 @@ contract B {
                 f.write("not source code")
             graph = parser.parse_directory(tmpdir)
         assert len(graph.nodes) == 0
+
+
+STATE_WEB_CODE = """\
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.0;
+
+contract Vault {
+    uint256 public total;
+    mapping(address => uint256) public bal;
+
+    function deposit(uint256 a) external {
+        bal[msg.sender] += a;
+        total = total + a;
+        uint256 scratch = total;
+    }
+}
+"""
+
+
+def _parse_state_web() -> CodeGraph:
+    parser = SolidityParser()
+    with tempfile.NamedTemporaryFile(mode="w", suffix=".sol", delete=False) as f:
+        f.write(STATE_WEB_CODE)
+        f.flush()
+        return parser.parse_file(f.name)
+
+
+class TestSolidityStateWeb:
+    """READS/WRITES edges to contract state variables (syntactic state web)."""
+
+    def test_state_variable_nodes(self) -> None:
+        graph = _parse_state_web()
+        state_vars = {n.id for n in graph.nodes.values() if n.kind == NodeKind.STATE_VARIABLE}
+        assert any(sid.endswith("Vault.total") for sid in state_vars)
+        assert any(sid.endswith("Vault.bal") for sid in state_vars)
+
+    def test_writes(self) -> None:
+        graph = _parse_state_web()
+        writes = {e.target_id.split(".")[-1] for e in graph.edges if e.kind == EdgeKind.WRITES}
+        assert writes == {"total", "bal"}
+
+    def test_reads_include_augmented_and_rhs(self) -> None:
+        graph = _parse_state_web()
+        reads = {e.target_id.split(".")[-1] for e in graph.edges if e.kind == EdgeKind.READS}
+        # `total = total + a` reads total; `bal[..] += a` reads bal.
+        assert "total" in reads
+        assert "bal" in reads
+
+    def test_locals_and_params_excluded(self) -> None:
+        graph = _parse_state_web()
+        targets = {
+            e.target_id.split(".")[-1]
+            for e in graph.edges
+            if e.kind in (EdgeKind.READS, EdgeKind.WRITES)
+        }
+        # `scratch` (local) and `a` (param) are not state variables.
+        assert "scratch" not in targets
+        assert "a" not in targets
+
+    def test_state_edges_are_certain(self) -> None:
+        graph = _parse_state_web()
+        state_edges = [e for e in graph.edges if e.kind in (EdgeKind.READS, EdgeKind.WRITES)]
+        assert state_edges
+        assert all(e.confidence == EdgeConfidence.CERTAIN for e in state_edges)

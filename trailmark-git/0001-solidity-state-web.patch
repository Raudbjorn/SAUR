diff --git a/src/trailmark/analysis/inheritance.py b/src/trailmark/analysis/inheritance.py
new file mode 100644
index 0000000..a1a62ce
--- /dev/null
+++ b/src/trailmark/analysis/inheritance.py
@@ -0,0 +1,214 @@
+"""Resolve inheritance, and attribute state accessed through it.
+
+WHY THIS MODULE EXISTS
+----------------------
+Two linked defects, both of which SILENTLY UNDER-REPORT -- the failure direction that
+reads as safety in an audit.
+
+**1. `inherits` edges dangled.** The Solidity parser builds an inherits target from the
+SOURCE file's module prefix, because when parsing `VaultLib.sol` it has no idea which file
+declares `VaultLibBase2`. So it emitted
+
+    release.core.fund.vault.VaultLib:VaultLib
+        --inherits--> release.core.fund.vault.VaultLib:VaultLibBase2   # no such node
+
+while the real node is ``persistent.vault.VaultLibBase2:VaultLibBase2``. Measured on
+Enzyme: 0 of 283 inherits edges resolved to an existing node. The inheritance graph
+existed on paper and was unusable in practice.
+
+**2. State declared in a base FILE was invisible.** The state web attributes an access
+only when the name matches a state variable declared in the same file
+(``parsers/solidity/parser.py::_add_state_edges``, which said as much: "Inherited-state
+resolution (INFERRED) is future work"). Every other accessed name was DISCARDED. So
+``VaultLib.claimOwnership``, whose body plainly does
+
+    address nextOwner = nominatedOwner;
+    delete nominatedOwner;
+    address prevOwner = owner;
+    owner = nextOwner;
+
+reported ZERO reads and ZERO writes, because `nominatedOwner` lives in
+``VaultLibBase2.sol`` and `owner` in ``VaultLibBaseCore.sol``. This is not an edge case:
+split base storage (``XLib is XLibBase2``, ``bases/``) is the standard convention for
+upgradeable proxy storage, so the blind spot lands hardest on exactly the architecture
+audits care most about. It was also indistinguishable from a genuinely state-free
+function -- 68% of Enzyme's function facts showed no state at all.
+
+Slither's resolved tier would fix this class of gap (it works off the compiled AST, not
+textual scope), but it is an OPTIONAL leg that needs a compilable project, and on the very
+target where this was found slither could not run at all. A compile-free floor cannot
+depend on the compiler to be honest.
+
+Both passes are over-approximate and mark their output ``INFERRED`` with a ``resolution``
+attribute, so a consumer can weigh them and a precise engine can later prune them.
+"""
+
+from __future__ import annotations
+
+from trailmark.models.edges import CodeEdge, EdgeConfidence, EdgeKind
+from trailmark.models.graph import CodeGraph
+from trailmark.models.nodes import (
+    READ_CANDIDATES_ATTR,
+    WRITE_CANDIDATES_ATTR,
+    NodeKind,
+)
+
+#: Kinds that can appear in an `is` clause and can declare state.
+_BASE_KINDS = frozenset({NodeKind.CONTRACT, NodeKind.INTERFACE, NodeKind.LIBRARY})
+
+
+def _bare(symbol: str) -> str:
+    """Callable/type name: module path first (``:``), dots inside it are path separators."""
+    return symbol.split(":")[-1].split(".")[-1]
+
+
+def resolve_inherits_edges(graph: CodeGraph) -> int:
+    """Point dangling ``inherits`` edges at the real base declarations.
+
+    Matches by bare type name, which is unambiguous in Solidity within a project except
+    for genuinely duplicated names (Enzyme really does ship two ``IHelperDataReader``).
+    On ambiguity every candidate is linked: over-approximating the inheritance graph
+    surfaces state and functions that MIGHT be inherited, whereas dropping the edge
+    guarantees they are missed.
+
+    The stale edge this repairs is itself removed once resolution runs: a target that
+    is not in ``graph.nodes`` is not a valid edge in this graph model, and leaving it in
+    place produces a ghost base alongside the repaired link for any consumer that does
+    not itself filter on ``target_id in graph.nodes``.
+
+    Idempotent. Returns the number of edges added.
+    """
+    by_name: dict[str, list[str]] = {}
+    for node_id, node in graph.nodes.items():
+        if node.kind in _BASE_KINDS:
+            by_name.setdefault(_bare(node_id), []).append(node_id)
+
+    existing = {(e.source_id, e.target_id) for e in graph.edges if e.kind == EdgeKind.INHERITS}
+    new_edges: list[CodeEdge] = []
+    dangling_ids: set[int] = set()
+    for edge in list(graph.edges):
+        if edge.kind != EdgeKind.INHERITS or edge.target_id in graph.nodes:
+            continue
+        dangling_ids.add(id(edge))
+        for candidate in sorted(by_name.get(_bare(edge.target_id), ())):
+            if candidate == edge.source_id or (edge.source_id, candidate) in existing:
+                continue
+            existing.add((edge.source_id, candidate))
+            new_edges.append(
+                CodeEdge(
+                    source_id=edge.source_id,
+                    target_id=candidate,
+                    kind=EdgeKind.INHERITS,
+                    confidence=EdgeConfidence.INFERRED,
+                    attributes=(
+                        ("resolution", "inherits-name-match"),
+                        ("raw_target", edge.target_id),
+                    ),
+                )
+            )
+    if dangling_ids:
+        graph.edges[:] = [e for e in graph.edges if id(e) not in dangling_ids]
+    graph.edges.extend(new_edges)
+    return len(new_edges)
+
+
+def _ancestors(graph: CodeGraph, container_id: str) -> list[str]:
+    """Transitive base containers of ``container_id`` (resolved inherits edges only)."""
+    out: list[str] = []
+    seen = {container_id}
+    stack = [container_id]
+    adjacency: dict[str, list[str]] = {}
+    for edge in graph.edges:
+        if edge.kind == EdgeKind.INHERITS and edge.target_id in graph.nodes:
+            adjacency.setdefault(edge.source_id, []).append(edge.target_id)
+    while stack:
+        cur = stack.pop()
+        for base in adjacency.get(cur, ()):
+            if base not in seen:
+                seen.add(base)
+                out.append(base)
+                stack.append(base)
+    return out
+
+
+def resolve_inherited_state(graph: CodeGraph) -> int:
+    """Add READS/WRITES edges for state a function inherits from a base container.
+
+    Uses the candidate accesses the parser recorded but could not attribute locally, and
+    resolves them against state variables declared on any transitive base. Edges are
+    ``INFERRED`` with ``resolution=inherited-state``, distinguishing them from the
+    ``CERTAIN`` same-contract edges: the name matched a base's declaration, which is
+    strong but not compiler-verified (a local shadow or a same-named var on an unrelated
+    base can fool it).
+
+    Requires ``resolve_inherits_edges`` to have run. Idempotent. Returns edges added.
+    """
+    # state vars declared per container: {container_id: {var_name: state_var_node_id}}
+    declared: dict[str, dict[str, str]] = {}
+    for node_id, node in graph.nodes.items():
+        if node.kind != NodeKind.STATE_VARIABLE:
+            continue
+        container = node_id.rsplit(".", 1)[0]
+        declared.setdefault(container, {})[_bare(node_id)] = node_id
+
+    # which container owns each function (contains edges)
+    owner_of: dict[str, str] = {}
+    for edge in graph.edges:
+        if edge.kind == EdgeKind.CONTAINS:
+            target = graph.nodes.get(edge.target_id)
+            if target is not None and target.kind in (NodeKind.FUNCTION, NodeKind.METHOD):
+                owner_of[edge.target_id] = edge.source_id
+
+    existing = {
+        (e.source_id, e.target_id, e.kind)
+        for e in graph.edges
+        if e.kind in (EdgeKind.READS, EdgeKind.WRITES)
+    }
+    ancestor_cache: dict[str, list[str]] = {}
+    new_edges: list[CodeEdge] = []
+
+    for node_id, node in graph.nodes.items():
+        if node.kind not in (NodeKind.FUNCTION, NodeKind.METHOD):
+            continue
+        attrs = dict(node.attributes)
+        candidates = {
+            EdgeKind.WRITES: attrs.get(WRITE_CANDIDATES_ATTR) or (),
+            EdgeKind.READS: attrs.get(READ_CANDIDATES_ATTR) or (),
+        }
+        if not candidates[EdgeKind.WRITES] and not candidates[EdgeKind.READS]:
+            continue
+        owner = owner_of.get(node_id)
+        if owner is None:
+            continue
+        if owner not in ancestor_cache:
+            ancestor_cache[owner] = _ancestors(graph, owner)
+        bases = ancestor_cache[owner]
+
+        for kind, names in candidates.items():
+            for name in names if isinstance(names, (list, tuple)) else str(names).split(","):
+                name = name.strip()
+                if not name:
+                    continue
+                for base in bases:
+                    target_id = declared.get(base, {}).get(name)
+                    if target_id is None:
+                        continue
+                    key = (node_id, target_id, kind)
+                    if key in existing:
+                        continue
+                    existing.add(key)
+                    new_edges.append(
+                        CodeEdge(
+                            source_id=node_id,
+                            target_id=target_id,
+                            kind=kind,
+                            confidence=EdgeConfidence.INFERRED,
+                            attributes=(
+                                ("resolution", "inherited-state"),
+                                ("declared_in", base),
+                            ),
+                        )
+                    )
+                    break  # nearest base wins; do not fan out over the whole chain
+    graph.edges.extend(new_edges)
+    return len(new_edges)

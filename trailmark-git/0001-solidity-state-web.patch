diff --git a/tests/test_query_core.py b/tests/test_query_core.py
new file mode 100644
index 0000000..c863fd5
--- /dev/null
+++ b/tests/test_query_core.py
@@ -0,0 +1,649 @@
+"""Regression tests for the unified query core.
+
+These lock in the fix for a real audit-tool defect: the call graph was SEVERED at every
+proxy node, so a sink reachable through an interface call or a ``this.f()`` self-call was
+reported as unreachable from any entrypoint. In an audit that failure direction is the
+expensive one -- "can an attacker reach this sink?" answered *no* when the truth is *yes*.
+
+Each test below names the specific wrong answer it prevents.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from trailmark.analysis.proxies import resolve_proxy_calls
+from trailmark.models.edges import EdgeConfidence, EdgeKind
+from trailmark.query import core
+from trailmark.query.api import QueryEngine
+
+IVAULT = """\
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+interface IVault {
+    function drain(address to) external;
+}
+"""
+
+VAULT = """\
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+contract Vault {
+    uint256 public total;
+    address public owner;
+
+    // THE SINK: internal, so not an entrypoint itself. Has no interface or proxy
+    // variant of its own -- which is why target-side name-union cannot reconnect it.
+    function _sweep(address to) internal {
+        total = 0;
+        owner = to;
+    }
+
+    function selfDrain() public {
+        _sweep(msg.sender);
+    }
+
+    function drain(address to) external {
+        _sweep(to);
+    }
+
+    function poke() external {
+        this.selfDrain();
+    }
+}
+"""
+
+ROUTER = """\
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import "./IVault.sol";
+
+contract Router {
+    IVault public vault;
+
+    function routeDrain(address to) external {
+        vault.drain(to);
+    }
+}
+"""
+
+
+@pytest.fixture
+def engine(tmp_path: Path) -> QueryEngine:
+    """A three-contract graph with both divergence shapes.
+
+    ``Router.routeDrain`` reaches ``Vault._sweep`` only through an interface-typed call;
+    ``Vault.poke`` reaches it only through a ``this.selfDrain()`` self-call.
+    """
+    src = tmp_path / "src"
+    src.mkdir()
+    (src / "IVault.sol").write_text(IVAULT)
+    (src / "Vault.sol").write_text(VAULT)
+    (src / "Router.sol").write_text(ROUTER)
+    return QueryEngine.from_directory(str(src), language="solidity")
+
+
+# --------------------------------------------------------------- graph repair
+
+
+def test_proxy_nodes_are_not_dead_ends(engine: QueryEngine) -> None:
+    """Before the fix, reachable_from(routeDrain) was exactly {the proxy node}.
+
+    The whole Vault subtree was invisible from Router, so every downstream sink looked
+    unreachable from the one untrusted caller that actually reaches it.
+    """
+    reachable = {n["id"] for n in engine.reachable_from("Router:Router.routeDrain")}
+    assert "Vault:Vault.drain" in reachable
+    assert "Vault:Vault._sweep" in reachable
+
+
+def test_interface_call_path_is_found(engine: QueryEngine) -> None:
+    """The interface-mediated route must appear, with the proxy hop preserved."""
+    paths = engine.paths_between("Router:Router.routeDrain", "Vault:Vault._sweep")
+    assert paths, "interface-mediated path is missing -- the false negative is back"
+    assert any("proxy.unresolved:vault.drain" in p for p in paths), (
+        "the proxy hop must stay ON the path so a reader can see that resolution "
+        "was inferred rather than statically proven"
+    )
+
+
+def test_self_call_path_is_found(engine: QueryEngine) -> None:
+    """`this.selfDrain()` must not sever poke from the sink."""
+    ancestors = {n["id"] for n in engine.ancestors_of("_sweep")}
+    assert "Vault:Vault.poke" in ancestors
+    assert "Router:Router.routeDrain" in ancestors
+
+
+def test_resolved_proxy_edges_are_marked_inferred(engine: QueryEngine) -> None:
+    """Over-approximated edges must be labelled, so consumers can report fidelity.
+
+    An inferred edge that claims to be certain is worse than no edge: it launders a
+    guess into a fact.
+    """
+    graph = engine.store.graph
+    resolved = [
+        e
+        for e in graph.edges
+        if e.kind == EdgeKind.CALLS and dict(e.attributes).get("resolution") == "proxy-name-union"
+    ]
+    assert resolved
+    assert all(e.confidence == EdgeConfidence.INFERRED for e in resolved)
+
+
+def test_bare_name_strips_the_module_path_first() -> None:
+    """A MODULE-qualified symbol must resolve to the callable's own name.
+
+    Module paths are separated from the member by ``:`` and contain dots as PATH
+    separators. Splitting on ``.`` alone yielded ``AddressListRegistry:isInList``, which
+    matches no function -- so the proxy stayed unresolved and the graph stayed severed.
+    That shape is the COMMON case on real imports (260 proxies on Enzyme, resolvable
+    share 50% -> 68%) while the toy ``vault.drain`` shape in the fixture above passed
+    either way, which is exactly why it went unnoticed.
+    """
+    assert core.bare_name("persistent.address-list-registry.AddressListRegistry:isInList") == (
+        "isInList"
+    )
+    assert core.bare_name("Vault:Vault.drain") == "drain"
+    assert core.bare_name("proxy.unresolved:this.selfDrain") == "selfDrain"
+    assert core.bare_name("vault.drain") == "drain"
+    assert core.bare_name("Animal::new") == "new"
+
+
+def test_bare_name_has_one_definition() -> None:
+    """core re-exports the analysis-layer function; two copies is how the bug survived."""
+    from trailmark.analysis import proxies
+
+    assert core.bare_name is proxies.bare_name
+
+
+def test_resolve_proxy_calls_is_idempotent(engine: QueryEngine) -> None:
+    """Re-running the pass must not duplicate edges (it runs per-file AND on merge)."""
+    graph = engine.store.graph
+    before = len(graph.edges)
+    assert resolve_proxy_calls(graph) == 0
+    assert len(graph.edges) == before
+
+
+# --------------------------------------------------------------- inherited state
+
+BASE_STORAGE = """\
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+contract VaultStorageBase {
+    address internal owner;
+    mapping(address => bool) internal isManager;
+    // A state variable named like a builtin MEMBER. Must still resolve: over-filtering
+    // these is how a real inherited write gets silently dropped.
+    string internal name;
+}
+"""
+
+DERIVED = """\
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import "./VaultStorageBase.sol";
+
+contract DerivedVault is VaultStorageBase {
+    function claim() external {
+        address prev = owner;
+        owner = msg.sender;
+        isManager[msg.sender] = true;
+        emit Claimed(prev, name);
+    }
+
+    event Claimed(address prev, string n);
+}
+"""
+
+
+@pytest.fixture
+def inherited(tmp_path: Path) -> QueryEngine:
+    """Split base storage -- the standard upgradeable-proxy convention."""
+    src = tmp_path / "src"
+    src.mkdir()
+    (src / "VaultStorageBase.sol").write_text(BASE_STORAGE)
+    (src / "DerivedVault.sol").write_text(DERIVED)
+    return QueryEngine.from_directory(str(src), language="solidity")
+
+
+def test_inherits_edges_resolve_across_files(inherited: QueryEngine) -> None:
+    """The parser builds an inherits target from the SOURCE file's module prefix.
+
+    It cannot know which file declares the base, so every such edge dangled: 0 of 283
+    resolved on Enzyme. An inheritance graph nothing can traverse is not a graph.
+    """
+    graph = inherited.store.graph
+    inherits = [e for e in graph.edges if e.kind == EdgeKind.INHERITS]
+    assert inherits
+    assert any(e.target_id in graph.nodes for e in inherits), (
+        "no inherits edge resolves to a real node -- the chain is untraversable"
+    )
+
+
+def test_state_declared_in_a_base_file_is_attributed(inherited: QueryEngine) -> None:
+    """The defect this pass exists for.
+
+    `DerivedVault.claim` plainly writes `owner` and `isManager`, but both are declared in
+    VaultStorageBase.sol, so the state web reported ZERO -- indistinguishable from a
+    genuinely state-free function, on exactly the split-storage layout that upgradeable
+    protocols use.
+    """
+    writes = {n["id"].split(":")[-1] for n in inherited.writes_of("DerivedVault.claim")}
+    assert "VaultStorageBase.owner" in writes
+    assert "VaultStorageBase.isManager" in writes
+
+
+def test_inherited_state_edges_are_marked_inferred(inherited: QueryEngine) -> None:
+    """Name-matched against a base is strong evidence, not compiler-verified fact."""
+    graph = inherited.store.graph
+    inherited_edges = [
+        e for e in graph.edges if dict(e.attributes).get("resolution") == "inherited-state"
+    ]
+    assert inherited_edges
+    assert all(e.confidence == EdgeConfidence.INFERRED for e in inherited_edges)
+    assert all(dict(e.attributes).get("declared_in") for e in inherited_edges)
+
+
+def test_builtin_filter_does_not_drop_state_named_like_a_member(
+    inherited: QueryEngine,
+) -> None:
+    """`name`, `balance`, `value` are among the COMMONEST Solidity state names.
+
+    They also appear as members of globals (`msg.value`, `abi.encode`). Filtering them out
+    of the candidate list to reduce noise would silently drop real inherited state -- an
+    under-report, which is the expensive direction. Only reserved words may be filtered.
+    """
+    reads = {n["id"].split(":")[-1] for n in inherited.reads_of("DerivedVault.claim")}
+    assert "VaultStorageBase.name" in reads
+
+
+TUPLE_WRITER = """\
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+contract Reserves {
+    uint112 reserveX;
+    uint112 reserveY;
+    mapping(address => uint256) balances;
+
+    function sync() external {
+        (reserveX, reserveY) = _cast();
+    }
+
+    function credit(address to) external {
+        balances[to] = 1;
+    }
+
+    function _cast() internal pure returns (uint112, uint112) {
+        return (1, 2);
+    }
+}
+"""
+
+
+def test_tuple_destructuring_records_every_write(tmp_path: Path) -> None:
+    """`(a, b) = f()` must write BOTH targets.
+
+    The LHS walker returned the first identifier it found, so on Ammalgam
+    `(referenceReserveX, referenceReserveY) = _castReserves(...)` recorded a write to
+    referenceReserveX only -- a state variable that is plainly assigned had one fewer
+    writer than it really has. Multi-writer state is exactly what the writers-graph and
+    the fold layer key on, so a dropped writer understates cross-operation asymmetry
+    where it matters most. Slither caught it; the compile-free tier must too.
+    """
+    src = tmp_path / "src"
+    src.mkdir()
+    (src / "Reserves.sol").write_text(TUPLE_WRITER)
+    qe = QueryEngine.from_directory(str(src), language="solidity")
+    writes = {n["id"].split(":")[-1] for n in qe.writes_of("Reserves.sync")}
+    assert writes == {"Reserves.reserveX", "Reserves.reserveY"}
+
+
+def test_indexed_write_is_still_a_single_write(tmp_path: Path) -> None:
+    """Unwrapping must not turn `balances[to] = 1` into a write to `to`."""
+    src = tmp_path / "src"
+    src.mkdir()
+    (src / "Reserves.sol").write_text(TUPLE_WRITER)
+    qe = QueryEngine.from_directory(str(src), language="solidity")
+    writes = {n["id"].split(":")[-1] for n in qe.writes_of("Reserves.credit")}
+    assert writes == {"Reserves.balances"}
+
+
+FIELD_SHADOW = """\
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+contract Shadow {
+    uint256 reserveX;
+    uint256 total;
+
+    struct Params { uint256 reserveX; }
+
+    function viaMember(Params memory p) external view returns (uint256) {
+        // p.reserveX is a FIELD on a local, not the state variable.
+        return p.reserveX + total;
+    }
+
+    function viaStructLiteral(uint256 v) external pure returns (Params memory) {
+        // `reserveX:` here is a struct-member KEY, not the state variable.
+        return Params({reserveX: v});
+    }
+}
+"""
+
+
+def test_member_field_is_not_a_state_read(tmp_path: Path) -> None:
+    """`p.reserveX` must not count as a read of the state variable `reserveX`.
+
+    Measured on Ammalgam: `inputParams.activeLiquidityAssets` (a field on a LOCAL struct)
+    was recorded as a read of `TokenController.activeLiquidityAssets`, giving that
+    variable six readers it does not have. Not harmless over-approximation -- reader and
+    co-writer counts feed the writers-graph and the frontier's exposure score, so
+    fabricated edges distort what the loop prioritises.
+    """
+    src = tmp_path / "src"
+    src.mkdir()
+    (src / "Shadow.sol").write_text(FIELD_SHADOW)
+    qe = QueryEngine.from_directory(str(src), language="solidity")
+    reads = {n["id"].split(":")[-1] for n in qe.reads_of("Shadow.viaMember")}
+    assert "Shadow.total" in reads, "a genuine state read must survive the filter"
+    assert "Shadow.reserveX" not in reads
+
+
+def test_struct_literal_key_is_not_a_state_read(tmp_path: Path) -> None:
+    """`Params({reserveX: v})` -- the key is a member name, not this contract's state.
+
+    Ammalgam's `computeAssetsState` never touches `reserveXAssets`, but the struct
+    literal `reserveXAssets: _reserveXAssets` made it look like a reader.
+    """
+    src = tmp_path / "src"
+    src.mkdir()
+    (src / "Shadow.sol").write_text(FIELD_SHADOW)
+    qe = QueryEngine.from_directory(str(src), language="solidity")
+    reads = {n["id"].split(":")[-1] for n in qe.reads_of("Shadow.viaStructLiteral")}
+    assert "Shadow.reserveX" not in reads
+
+
+def test_inheritance_passes_are_idempotent(inherited: QueryEngine) -> None:
+    """They run per-file AND on the merged graph; neither may duplicate edges."""
+    from trailmark.analysis.inheritance import resolve_inherited_state, resolve_inherits_edges
+
+    graph = inherited.store.graph
+    before = len(graph.edges)
+    assert resolve_inherits_edges(graph) == 0
+    assert resolve_inherited_state(graph) == 0
+    assert len(graph.edges) == before
+
+
+# --------------------------------------------------------------- storage pointers
+
+POINTER_LIB = """\
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+library Sat {
+    struct S { uint16 maxLeaf; }
+    function update(S storage st, uint16 v) internal { helper(st, v); }
+    function helper(S storage st, uint16 v) internal { st.maxLeaf = v; }
+    function inspect(S storage st) internal view returns (uint16) { return st.maxLeaf; }
+}
+"""
+
+POINTER_HOLDER = """\
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import "./Sat.sol";
+
+contract Holder {
+    mapping(address => Sat.S) satData;
+    Sat.S other;
+
+    function viaAlias() external {
+        Sat.S storage p = satData[msg.sender];
+        p.maxLeaf = 1;            // direct alias write
+    }
+
+    function viaLibrary() external {
+        Sat.S storage p = satData[msg.sender];
+        Sat.update(p, 5);         // write happens 2 hops away, inside the library
+    }
+
+    function viaDirectArg() external {
+        Sat.update(satData[msg.sender], 7);   // no alias at all
+    }
+
+    function readOnly() external view returns (uint16) {
+        Sat.S storage p = other;
+        return Sat.inspect(p);    // callee only reads -> must NOT be a writer
+    }
+
+    function memoryCopy() external view returns (uint16) {
+        Sat.S memory m = satData[msg.sender];
+        return m.maxLeaf;         // mutating a copy would change nothing
+    }
+}
+"""
+
+
+@pytest.fixture
+def pointers(tmp_path: Path) -> QueryEngine:
+    src = tmp_path / "src"
+    src.mkdir()
+    (src / "Sat.sol").write_text(POINTER_LIB)
+    (src / "Holder.sol").write_text(POINTER_HOLDER)
+    return QueryEngine.from_directory(str(src), language="solidity")
+
+
+def test_local_storage_alias_write_is_attributed(pointers: QueryEngine) -> None:
+    """`S storage p = satData[k]; p.f = v` writes satData while naming it nowhere."""
+    writes = {n["id"].split(":")[-1] for n in pointers.writes_of("Holder.viaAlias")}
+    assert "Holder.satData" in writes
+
+
+def test_write_through_a_library_storage_param_is_attributed(
+    pointers: QueryEngine,
+) -> None:
+    """The case that made Ammalgam's saturation state look unwritten.
+
+    `Sat.update(p, v)` -> `helper(st, v)` -> `st.maxLeaf = v`. The library has NO state of
+    its own, so the write names no state variable anywhere in the callee -- invisible to a
+    name-based state web AND to grep. Before this pass `satDataGivenPair` and
+    `TWAPDataGivenPair` had ZERO recorded writers, which would make any certificate
+    quantifying over "all writers" vacuously true.
+    """
+    writes = {n["id"].split(":")[-1] for n in pointers.writes_of("Holder.viaLibrary")}
+    assert "Holder.satData" in writes
+
+
+def test_state_passed_directly_as_an_argument_is_attributed(
+    pointers: QueryEngine,
+) -> None:
+    """`Sat.update(satData[k], v)` -- no local alias; this is Ammalgam's actual shape."""
+    writes = {n["id"].split(":")[-1] for n in pointers.writes_of("Holder.viaDirectArg")}
+    assert "Holder.satData" in writes
+
+
+def test_read_only_library_call_is_not_a_write(pointers: QueryEngine) -> None:
+    """Over-approximating writers has a cost: it inflates multi-writer asymmetry.
+
+    Only callees that actually mutate the storage parameter may create a writer.
+    """
+    writes = {n["id"].split(":")[-1] for n in pointers.writes_of("Holder.readOnly")}
+    assert "Holder.other" not in writes
+
+
+def test_memory_copy_is_not_a_state_write(pointers: QueryEngine) -> None:
+    """`S memory m = ...` is a COPY; mutating it changes no state."""
+    writes = {n["id"].split(":")[-1] for n in pointers.writes_of("Holder.memoryCopy")}
+    assert writes == set()
+
+
+def test_storage_pointer_edges_are_marked_inferred(pointers: QueryEngine) -> None:
+    from trailmark.analysis.storage_pointers import resolve_storage_pointer_writes
+
+    graph = pointers.store.graph
+    edges = [e for e in graph.edges if dict(e.attributes).get("resolution") == "storage-pointer"]
+    assert edges
+    assert all(e.confidence == EdgeConfidence.INFERRED for e in edges)
+    # idempotent: runs per-file AND on the merged graph
+    before = len(graph.edges)
+    assert resolve_storage_pointer_writes(graph) == 0
+    assert len(graph.edges) == before
+
+
+# --------------------------------------------------------------- name resolution
+
+
+def test_bare_name_resolves_to_all_variants(engine: QueryEngine) -> None:
+    """`drain` denotes the impl, the interface declaration, AND the proxy."""
+    res = engine.resolve_name("drain")
+    assert set(res.ids) == {
+        "IVault:IVault.drain",
+        "Vault:Vault.drain",
+        "proxy.unresolved:vault.drain",
+    }
+    assert res.ambiguous
+
+
+def test_qualified_name_is_scoped(engine: QueryEngine) -> None:
+    """`Vault.drain` must NOT widen to the interface's same-named method."""
+    assert engine.resolve_name("Vault.drain").ids == ("Vault:Vault.drain",)
+
+
+def test_exact_node_id_is_not_widened(engine: QueryEngine) -> None:
+    """An explicit id is an instruction, not a search."""
+    res = engine.resolve_name("Vault:Vault.drain")
+    assert res.ids == ("Vault:Vault.drain",)
+    assert res.exact
+
+
+def test_resolution_is_deterministic(tmp_path: Path) -> None:
+    """find_node_id returned the FIRST dict match, so results depended on parse order.
+
+    Rebuilding the same graph must give byte-identical resolution every time.
+    """
+    src = tmp_path / "src"
+    src.mkdir()
+    (src / "IVault.sol").write_text(IVAULT)
+    (src / "Vault.sol").write_text(VAULT)
+    (src / "Router.sol").write_text(ROUTER)
+    results = {
+        QueryEngine.from_directory(str(src), language="solidity").resolve_name("drain").ids
+        for _ in range(5)
+    }
+    assert len(results) == 1
+
+
+def test_unknown_name_resolves_to_nothing(engine: QueryEngine) -> None:
+    res = engine.resolve_name("noSuchFunction")
+    assert not res
+    assert res.ids == ()
+
+
+# --------------------------------------------------------------- honest reporting
+
+
+def test_unknown_name_is_distinguishable_from_unreachable(engine: QueryEngine) -> None:
+    """The single most dangerous conflation: a typo must not read as a safe result."""
+    unknown = engine.entrypoint_paths_report("noSuchFunction")
+    assert unknown["resolved"] is False
+    assert unknown["reachable"] is False
+
+    reached = engine.entrypoint_paths_report("_sweep")
+    assert reached["resolved"] is True
+    assert reached["reachable"] is True
+
+
+def test_verdict_is_not_derived_from_capped_paths(engine: QueryEngine) -> None:
+    """`reachable` must come from ancestor closure, not from the path list.
+
+    ``Router.routeDrain`` reaches the sink in 3 hops. At ``max_depth=1`` that route is
+    invisible, yet the sink IS reachable from it. If the verdict were ``bool(paths)``
+    this would be a false negative -- the same bug in a new costume.
+    """
+    shallow = engine.entrypoint_paths_report("_sweep", max_depth=1)
+    assert shallow["reachable"] is True
+    assert "Router:Router.routeDrain" in shallow["reaching_entrypoints"]
+    assert not any("Router:Router.routeDrain" in p for p in shallow["paths"]), (
+        "a 3-hop route must not appear at max_depth=1"
+    )
+
+    deep = engine.entrypoint_paths_report("_sweep", max_depth=3)
+    assert any("Router:Router.routeDrain" in p for p in deep["paths"]), (
+        "max_depth is in HOPS: a 3-hop path must be visible at max_depth=3"
+    )
+
+
+def test_max_depth_zero_is_rejected_not_silently_unlimited(engine: QueryEngine) -> None:
+    """rustworkx reads cutoff=0 as 'no limit', so 0 must not reach it.
+
+    Left unguarded, ``max_depth=0`` returned MORE paths than ``max_depth=1``.
+    """
+    with pytest.raises(ValueError, match="hops and must be >= 1"):
+        engine.entrypoint_paths_report("_sweep", max_depth=0)
+
+
+def test_paths_beyond_max_depth_flag(engine: QueryEngine) -> None:
+    """reachable=True with paths=[] must be labelled a display limit, not safety."""
+    rep = engine.entrypoint_paths_report("Vault:Vault._sweep", max_depth=1, limit=0)
+    assert rep["reachable"] is True
+    assert rep["paths"] == []
+    assert rep["paths_beyond_max_depth"] is True
+
+
+def test_truncation_is_flagged(engine: QueryEngine) -> None:
+    """A capped path list that looks complete is a silent under-report."""
+    rep = engine.entrypoint_paths_report("_sweep", limit=1)
+    assert len(rep["paths"]) == 1
+    assert rep["paths_truncated"] is True
+
+    full = engine.entrypoint_paths_report("_sweep", limit=None)
+    assert full["paths_truncated"] is False
+    assert len(full["paths"]) > 1
+
+
+def test_reaching_entrypoints_names_the_untrusted_caller(engine: QueryEngine) -> None:
+    """The audit-relevant output: WHICH entrypoints reach the sink."""
+    reaching, _ = core.reaching_entrypoints(engine.store, "_sweep")
+    assert "Router:Router.routeDrain" in reaching
+    assert "Vault:Vault.poke" in reaching
+
+
+# --------------------------------------------------------------- state web
+
+
+def test_state_access_aggregates_over_variants(engine: QueryEngine) -> None:
+    writes = {n["id"] for n in engine.writes_of("_sweep")}
+    assert writes == {"Vault:Vault.total", "Vault:Vault.owner"}
+
+
+def test_state_access_rejects_bad_mode(engine: QueryEngine) -> None:
+    with pytest.raises(ValueError, match="mode must be"):
+        core.state_access(engine.store, "_sweep", mode="mutates")
+
+
+def test_direction_arguments_are_validated(engine: QueryEngine) -> None:
+    with pytest.raises(ValueError, match="direction must be"):
+        core.neighbors(engine.store, "_sweep", direction="sideways")
+    with pytest.raises(ValueError, match="direction must be"):
+        core.closure(engine.store, "_sweep", direction="sideways")
+
+
+# --------------------------------------------------------------- encapsulation
+
+
+def test_public_accessors_replace_private_reach_through(engine: QueryEngine) -> None:
+    """The MCP server used ``qe._store.paths_between``; that had no stability promise."""
+    assert engine.store is not None
+    assert engine.store.graph is not None
+    assert engine.entrypoint_ids()
+    assert engine.paths_between_ids("Vault:Vault.drain", "Vault:Vault._sweep")
+    assert engine.entrypoint_paths_to_id("Vault:Vault._sweep")

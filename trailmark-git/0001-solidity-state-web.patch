+    # VISIBLE state, which includes anything declared on a base.
+    resolve_storage_pointer_writes(graph)
     return graph
 
 
+def resolve_proxy_calls(graph: CodeGraph) -> int:
+    """Link proxy nodes to candidate implementations so traversals don't DEAD-END.
+
+    WHY THIS EXISTS
+    ---------------
+    ``_materialize_unresolved_calls`` turns a dangling call target into a proxy NODE,
+    which keeps the call site visible -- but that node is a LEAF. Nothing points from
+    it to the function it actually stands for, so the call graph is *severed* at every
+    interface call and every ``this.f()`` self-call. Measured on a 3-contract fixture:
+
+        Router.routeDrain --calls--> proxy.unresolved:vault.drain      # dead end
+        Vault.drain       --calls--> Vault._sweep
+
+    ``reachable_from("Router.routeDrain")`` returned exactly
+    ``{proxy.unresolved:vault.drain}`` -- the whole Vault subtree invisible -- and
+    ``ancestors_of("_sweep")`` omitted both ``routeDrain`` and ``poke``. For an audit
+    that is the worst possible failure direction: the question "can an untrusted caller
+    reach this sink?" is answered *no* when the true answer is *yes*.
+
+    Aggregating over same-named variants at the QUERY TARGET (what callers were doing
+    to paper over this) cannot fix it: the sink ``_sweep`` is internal and has no
+    interface or proxy variant of its own, so no amount of name-union at the target
+    reconnects it to ``routeDrain``. The cut has to be repaired in the GRAPH, once,
+    where every query benefits.
+
+    RESOLUTION POLICY (deliberately over-approximate)
+    -------------------------------------------------
+    A proxy's raw symbol ``recv.fn`` / ``this.fn`` carries a receiver we cannot resolve
+    without type inference, so we link the proxy to EVERY function/method whose bare
+    name matches ``fn``. That can introduce a call edge to a same-named function on an
+    unrelated contract. This is the safe direction and is chosen on purpose: an extra
+    candidate path costs an analyst one dismissal, while a missing path costs a missed
+    finding. Edges are marked ``confidence=INFERRED`` with ``resolution`` and
+    ``candidates`` attributes so consumers can report the fidelity honestly and so a
+    precise engine (slither) can later PROMOTE or prune them.
+
+    The proxy node is kept ON the path (``routeDrain -> proxy.unresolved:vault.drain
+    -> Vault.drain -> _sweep``) rather than short-circuited, so a rendered path shows
+    exactly where inference happened instead of implying a resolved static call.
+
+    Idempotent: existing proxy->impl edges are never duplicated. Returns the number of
+    edges added.
+    """
+    callable_kinds = {NodeKind.FUNCTION, NodeKind.METHOD}
+    by_bare_name: dict[str, list[str]] = {}
+    for node_id, node in graph.nodes.items():
+        if node.kind not in callable_kinds:
+            continue
+        by_bare_name.setdefault(_bare_name(node_id), []).append(node_id)
+
+    existing = {
+        (edge.source_id, edge.target_id) for edge in graph.edges if edge.kind == EdgeKind.CALLS
+    }
+
+    new_edges: list[CodeEdge] = []
+    for node_id, node in graph.nodes.items():
+        if node.kind != NodeKind.PROXY:
+            continue
+        raw = dict(node.attributes).get("raw_symbol") or node.name
+        target_name = _bare_name(str(raw))
+        candidates = [c for c in by_bare_name.get(target_name, []) if c != node_id]
+        if not candidates:
+            continue
+        for candidate in sorted(candidates):
+            if (node_id, candidate) in existing:
+                continue
+            existing.add((node_id, candidate))
+            new_edges.append(
+                CodeEdge(
+                    source_id=node_id,
+                    target_id=candidate,
+                    kind=EdgeKind.CALLS,
+                    confidence=EdgeConfidence.INFERRED,
+                    attributes=(
+                        ("resolution", "proxy-name-union"),
+                        ("raw_symbol", str(raw)),
+                        ("candidates", len(candidates)),
+                    ),
+                )
+            )
+
+    graph.edges.extend(new_edges)
+    return len(new_edges)
+
+
+def bare_name(symbol: str) -> str:
+    """The callable's own name, from a node id or a raw call symbol.
+
+    THE single definition; ``trailmark.query.core`` re-exports it. It cannot live in
+    ``query.core`` because ``trailmark.query.__init__`` imports ``api``, which imports this
+    module -- so a ``query`` import from here would be circular. It lives at the analysis
+    layer, where the graph repair that depends on it also lives.
+
+    The MODULE part comes first and is separated by ``:``; dots inside it are path
+    separators, not member access. So strip to the last ``:`` FIRST, then take the last
+    dotted segment:
+
+    ``Vault:Vault.drain``                -> ``drain``
+    ``proxy.unresolved:this.selfDrain``  -> ``selfDrain``
+    ``vault.drain``                      -> ``drain``
+    ``persistent.address-list-registry.AddressListRegistry:isInList`` -> ``isInList``
+
+    Splitting on ``.`` alone got that last case wrong -- it yielded
+    ``AddressListRegistry:isInList``, which matches no function, so the proxy stayed
+    unresolved and the call graph stayed severed there. On Enzyme that was 260 proxies
+    (resolvable share 50% -> 68%). Module-qualified symbols are the COMMON case on real
+    imports, so the naive split failed quietly on real code while passing on the toy
+    ``vault.drain`` shape used in tests.
+    """
+    return symbol.split(":")[-1].split(".")[-1]
+
+
+#: Back-compat alias for the previously private name.
+_bare_name = bare_name
+
+
 def _materialize_unresolved_calls(graph: CodeGraph) -> None:
     """Rewrite dangling call targets to proxy nodes so traversals retain them."""
     new_edges: list[CodeEdge] = []
diff --git a/src/trailmark/analysis/storage_pointers.py b/src/trailmark/analysis/storage_pointers.py
new file mode 100644
index 0000000..1725b63
--- /dev/null
+++ b/src/trailmark/analysis/storage_pointers.py
@@ -0,0 +1,211 @@
+"""Attribute state writes that happen through a ``storage`` pointer.
+
+WHY THIS MODULE EXISTS
+----------------------
+A Solidity ``storage`` parameter is a POINTER into the caller's state. So::
+
+    // SaturationAndGeometricTWAPState.sol
+    Saturation.SaturationStruct storage satStruct = satDataGivenPair[msg.sender];
+    Saturation.update(satStruct, ...);
+
+    // Saturation.sol  (a library -- it has NO state of its own)
+    function update(SaturationStruct storage satStruct, ...) internal {
+        satStruct.maxLeaf = uint16(maxLeaf);          // writes satDataGivenPair
+    }
+
+The write mutates ``satDataGivenPair`` while naming it nowhere in the callee. A
+name-based state web cannot see it, and neither can ``grep`` -- the variable's name does
+not appear at the write site at all. Measured on Ammalgam before this pass:
+``satDataGivenPair`` and ``TWAPDataGivenPair`` had **zero** recorded writers, despite
+holding the protocol's entire saturation and TWAP state.
+
+That failure mode is worse than a plain miss. A composition/certificate layer that asks
+"does invariant I hold across ALL writers of V" over an empty writer set returns
+*vacuously proven* -- confident, and false, on the most security-critical state in the
+system. Completeness of the writer set is a SOUNDNESS precondition for composed
+reasoning, not a quality metric, and this is the dominant hole in it.
+
+HOW
+---
+The parser records three local facts per function (it cannot do more, because it sees one
+file at a time): which parameters are ``storage``, which of those the body writes, and
+what base identifier each call site passes in each argument position (with local
+``T storage p = <state expr>`` aliases already resolved to the state expression).
+
+This pass closes the loop across files:
+
+1. Seed: a function directly writing its own storage parameter writes that INDEX.
+2. Fixpoint: if ``f`` passes its own storage parameter *j* into ``g``'s position *i* and
+   ``g`` writes *i*, then ``f`` writes *j*. Iterate until stable -- this is what carries
+   the effect up through helper chains.
+3. Attribute: at every call site whose argument resolves to a real state variable, if the
+   callee writes that index, record a WRITES edge from the CALLING function to that state
+   variable.
+
+The write is attributed to the caller, not the library: the caller is the one whose state
+changes, and it is the node an audit reasons about. Edges are ``INFERRED`` with
+``resolution=storage-pointer``, so a consumer can weigh them and a precise engine can
+prune them.
+
+Matching is by bare function name, so an overload or a same-named helper on an unrelated
+contract can over-attribute. That is the intended direction: a surplus writer costs a
+dismissal, a missing writer silently voids a proof.
+"""
+
+from __future__ import annotations
+
+from trailmark.models.edges import CodeEdge, EdgeConfidence, EdgeKind
+from trailmark.models.graph import CodeGraph
+from trailmark.models.nodes import (
+    STORAGE_ARG_CALLS_ATTR,
+    STORAGE_PARAM_WRITES_ATTR,
+    STORAGE_PARAMS_ATTR,
+    NodeKind,
+)
+
+_CALLABLE = (NodeKind.FUNCTION, NodeKind.METHOD)
+
+
+def _bare(symbol: str) -> str:
+    return symbol.split(":")[-1].split(".")[-1]
+
+
+def _parse_arg_calls(raw: str) -> list[tuple[str, int, str]]:
+    """``"update#0:satDataGivenPair;foo#1:x"`` -> [(callee, index, base), ...]."""
+    out: list[tuple[str, int, str]] = []
+    for entry in raw.split(";"):
+        if not entry:
+            continue
+        head, _, base = entry.partition(":")
+        callee, _, index = head.partition("#")
+        if callee and index.isdigit() and base:
+            out.append((callee, int(index), base))
+    return out
+
+
+def resolve_storage_pointer_writes(graph: CodeGraph) -> int:
+    """Add WRITES edges for state mutated through a ``storage`` parameter.
+
+    Idempotent. Returns the number of edges added.
+    """
+    # --- gather per-function facts -------------------------------------------------
+    params_of: dict[str, list[str]] = {}
+    direct_writes: dict[str, set[int]] = {}
+    arg_calls_of: dict[str, list[tuple[str, int, str]]] = {}
+    for node_id, node in graph.nodes.items():
+        if node.kind not in _CALLABLE:
+            continue
+        attrs = dict(node.attributes)
+        raw_params = str(attrs.get(STORAGE_PARAMS_ATTR) or "")
+        params = [p for p in raw_params.split(",") if p]
+        if params:
+            params_of[node_id] = params
+            written = str(attrs.get(STORAGE_PARAM_WRITES_ATTR) or "")
+            idx = {params.index(w) for w in written.split(",") if w in params}
+            if idx:
+                direct_writes[node_id] = idx
+        raw_calls = str(attrs.get(STORAGE_ARG_CALLS_ATTR) or "")
+        if raw_calls:
+            arg_calls_of[node_id] = _parse_arg_calls(raw_calls)
+
+    if not params_of:
+        return 0
+
+    # index functions by bare name: call sites only know the callee's own name
+    by_name: dict[str, list[str]] = {}
+    for node_id in params_of:
+        by_name.setdefault(_bare(node_id), []).append(node_id)
+
+    # --- fixpoint: propagate "writes storage param i" up through helper chains ------
+    writes_index: dict[str, set[int]] = {k: set(v) for k, v in direct_writes.items()}
+    changed = True
+    while changed:
+        changed = False
+        for caller, calls in arg_calls_of.items():
+            caller_params = params_of.get(caller)
+            if not caller_params:
+                continue
+            for callee_name, index, base in calls:
+                if base not in caller_params:
+                    continue  # the argument is not one of the caller's own pointers
+                for callee_id in by_name.get(callee_name, ()):
+                    if index in writes_index.get(callee_id, ()):
+                        j = caller_params.index(base)
+                        if j not in writes_index.setdefault(caller, set()):
+                            writes_index[caller].add(j)
+                            changed = True
+
+    # --- attribute to real state variables at the call sites ------------------------
+    state_by_container: dict[str, dict[str, str]] = {}
+    for node_id, node in graph.nodes.items():
+        if node.kind == NodeKind.STATE_VARIABLE:
+            container = node_id.rsplit(".", 1)[0]
+            state_by_container.setdefault(container, {})[_bare(node_id)] = node_id
+
+    owner_of: dict[str, str] = {}
+    for edge in graph.edges:
+        if edge.kind == EdgeKind.CONTAINS:
+            target = graph.nodes.get(edge.target_id)
+            if target is not None and target.kind in _CALLABLE:
+                owner_of[edge.target_id] = edge.source_id
+

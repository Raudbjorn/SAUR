index 0000000..dd06a82
--- /dev/null
+++ b/src/trailmark/query/core.py
@@ -0,0 +1,321 @@
+"""The single query core: one name-resolution policy, one traversal semantics.
+
+WHY THIS MODULE EXISTS
+----------------------
+Three surfaces reach this graph -- the ``tmq`` CLI, the trailmark MCP server, and
+``l0-context-extract``'s batch KB commit. Each had grown its OWN name resolution and
+its own idea of what "reachable" means, and they disagreed:
+
+  * ``GraphStore.find_node`` returns the FIRST dict match, so ``find_node_id("drain")``
+    on a graph containing both ``IVault:IVault.drain`` and ``Vault:Vault.drain`` yields
+    whichever file happened to parse first. Parse order is not a resolution policy.
+  * the MCP unioned same-named variants with an ad-hoc ``id.split(".")[-1]``;
+  * ``tmq`` resolved to a list but then reported each variant SEPARATELY, so the impl
+    variant printed ``(0)`` next to an interface variant that had paths -- a zero that
+    reads as "unreachable" when it means "not under this name".
+
+Two implementations of one question give two answers, and the consumer cannot tell
+which is wrong. This module is the one implementation. Both surfaces are adapters over
+it and cannot drift again.
+
+Note the division of labor: the *graph* is repaired in
+``trailmark.analysis.proxies.resolve_proxy_calls`` (proxy nodes used to dead-end,
+severing every interface and ``this.f()`` call). This module does not paper over
+structural gaps -- it only decides which nodes a NAME denotes, and aggregates
+traversal over all of them.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import TYPE_CHECKING
+
+from trailmark.analysis.proxies import bare_name as _proxy_bare_name
+from trailmark.models.nodes import NodeKind
+
+if TYPE_CHECKING:
+    from trailmark.storage.graph_store import GraphStore
+
+#: Node kinds that can appear as the source or target of a call.
+CALLABLE_KINDS = frozenset({NodeKind.FUNCTION, NodeKind.METHOD})
+
+#: Kinds a bare function-name query is allowed to denote. PROXY is included: an
+#: unresolved ``recv.f`` node legitimately stands for "some f" and callers asking
+#: "what reaches f" must see traffic arriving at it.
+NAME_TARGET_KINDS = frozenset(CALLABLE_KINDS | {NodeKind.PROXY})
+
+
+def _cutoff(max_depth: int) -> int:
+    """Convert ``max_depth`` in HOPS to the node-count cutoff the store expects.
+
+    Two sharp edges in the underlying ``rustworkx.digraph_all_simple_paths`` cutoff,
+    both measured rather than assumed:
+
+    * it counts NODES, not edges, so a genuine 3-hop path needs ``cutoff=4``. Passing
+      hops straight through silently dropped the longest legitimate path in the test
+      fixture -- an under-report, the direction that costs findings.
+    * ``cutoff=0`` means NO LIMIT. So ``max_depth=0``, the obvious way to write "don't
+      traverse", returned MORE paths than ``max_depth=1`` -- and on a large graph would
+      enumerate everything instead of nothing.
+
+    This module therefore takes ``max_depth`` in hops and rejects values below 1, so the
+    parameter cannot quietly invert its own meaning.
+    """
+    if max_depth < 1:
+        raise ValueError(
+            f"max_depth is in hops and must be >= 1, got {max_depth}. "
+            "(0 does not mean 'no traversal' -- the underlying cutoff reads it as "
+            "'unlimited', which is the opposite of what a caller intends.)"
+        )
+    return max_depth + 1
+
+
+#: Re-exported from ``trailmark.analysis.proxies``, which owns the ONE definition (a
+#: ``query`` import from there would be circular -- see that docstring). Two copies of
+#: this function is what let the naive ``split(".")`` survive: the graph repair and the
+#: resolver each had their own, so fixing one would not have fixed the other.
+bare_name = _proxy_bare_name
+
+
+@dataclass(frozen=True)
+class Resolution:
+    """What a name denotes, with enough detail for an honest answer.
+
+    ``ids`` is the full variant set; a caller that reports on only one of several
+    variants is obliged to say so, which is why ``variant_count`` is part of the
+    result rather than something each surface recomputes.
+    """
+
+    query: str
+    ids: tuple[str, ...] = ()
+    exact: bool = False
+    kinds: dict[str, int] = field(default_factory=dict)
+
+    def __bool__(self) -> bool:
+        return bool(self.ids)
+
+    @property
+    def variant_count(self) -> int:
+        return len(self.ids)
+
+    @property
+    def ambiguous(self) -> bool:
+        """True when a name denotes more than one node.
+
+        Not an error: an interface declaration plus its implementation plus an
+        unresolved proxy are three legitimate nodes for one name. It IS a fact the
+        consumer must surface, because "reachable" then means "reachable to any".
+        """
+        return len(self.ids) > 1
+
+
+def resolve(store: GraphStore, name: str, kinds: frozenset | None = None) -> Resolution:
+    """Resolve ``name`` to EVERY node it denotes, under one documented policy.
+
+    Policy, in precedence order:
+
+    1. **Exact node id** -- returns that single node, ``exact=True``. An explicit id is
+       an instruction, not a search; it is never widened to siblings.
+    2. **Qualified name** (contains ``.``, e.g. ``Vault.drain``) -- every node whose id
+       ends with ``:Vault.drain`` or ``.Vault.drain``, plus proxy nodes whose raw symbol
+       ends the same way. Scoped: ``Vault.drain`` will not match ``Other.drain``.
+    3. **Bare name** (``drain``) -- every node whose bare name is ``drain``. This is the
+       widening step, and it is deliberate: it is what makes the interface declaration,
+       the implementation, and ``proxy.unresolved:vault.drain`` one answer instead of
+       three disagreeing ones.
+
+    ``kinds`` filters the result; it defaults to ``NAME_TARGET_KINDS``. Results are
+    sorted, so a query answers identically across runs regardless of parse order --
+    the specific defect that made ``find_node_id`` unreliable.
+
+    Over-approximation is the intended failure direction. A surplus variant costs the
+    reader one dismissal; a missing variant costs a missed finding.
+    """
+    allowed = NAME_TARGET_KINDS if kinds is None else kinds
+    graph = store.graph
+
+    if name in graph.nodes:
+        node = graph.nodes[name]
+        return Resolution(query=name, ids=(name,), exact=True, kinds={node.kind.value: 1})
+
+    qualified = "." in name
+    matches: list[str] = []
+    for node_id, node in graph.nodes.items():
+        if node.kind not in allowed:
+            continue
+        if node.kind == NodeKind.PROXY:
+            raw = str(dict(node.attributes).get("raw_symbol") or node.name)
+            hit = raw == name or raw.endswith(f".{name}") if qualified else bare_name(raw) == name
+        elif qualified:
+            hit = node_id.endswith(f":{name}") or node_id.endswith(f".{name}") or node.name == name
+        else:
+            hit = bare_name(node_id) == name or node.name == name
+        if hit:
+            matches.append(node_id)
+
+    matches.sort()
+    kind_counts: dict[str, int] = {}
+    for node_id in matches:
+        k = graph.nodes[node_id].kind.value
+        kind_counts[k] = kind_counts.get(k, 0) + 1
+    return Resolution(query=name, ids=tuple(matches), kinds=kind_counts)
+
+
+def reaching_entrypoints(
+    store: GraphStore,
+    name: str,
+    *,
+    kinds: frozenset | None = None,
+) -> tuple[list[str], Resolution]:
+    """Entrypoints that can reach any variant of ``name``, at ANY depth.
+
+    This is the reachability VERDICT, and it is deliberately not derived from path
+    enumeration. Two reasons:
+
+    * **Correctness.** Path enumeration is depth-capped (``max_depth``, default 20). A
+      sink sitting 21 calls below an entrypoint yields zero paths, and a caller reading
+      "no paths" as "not reachable" gets a false negative -- the exact failure this
+      module exists to remove. Ancestor closure has no depth limit, so the verdict is
+      complete.
+    * **Cost.** On Enzyme (4.9k nodes) enumerating every path to ``getOwner`` at depth
+      20 produces 62k paths in ~4s; the ancestor set answers the same question in
+      milliseconds. Callers overwhelmingly want the verdict, not 62k paths.
+
+    Paths remain valuable as EVIDENCE, which is why :func:`entrypoint_paths` still
+    exists -- but evidence is bounded, and the verdict is not derived from it.
+    """
+    res = resolve(store, name, kinds=kinds)
+    entrypoints = set(store.graph.entrypoints)
+    reaching: set[str] = set()
+    for node_id in res.ids:
+        if node_id in entrypoints:
+            reaching.add(node_id)
+        reaching.update(store.ancestors_of(node_id) & entrypoints)
+    return sorted(reaching), res
+
+
+def entrypoint_paths(
+    store: GraphStore,
+    name: str,
+    *,
+    max_depth: int = 20,
+    limit: int | None = None,
+    kinds: frozenset | None = None,
+) -> tuple[list[list[str]], Resolution, bool]:
+    """Entrypoint->``name`` call paths, aggregated over ALL variants of the name.
+
+    Returns ``(paths, resolution, truncated)``, node IDS preserved -- never display
+    names. Collapsing to bare names here would make two distinct ``drain`` functions
+    look like one path and would leave the caller unable to re-query a node it just
+    saw; surfaces format labels at the edge, from the ids.
+
+    ``limit`` bounds how many paths are collected. ``truncated`` says whether anything
+    was dropped, and it is a required part of the return rather than an optional extra:
+    a truncated path list that looks complete is a silent under-report, and "the tool
+    showed me every path" is exactly the belief that turns a cap into a missed finding.
+
+    Do NOT read an empty list as "unreachable". It also happens when the name is
+    unknown, and when the only paths are longer than ``max_depth``. Use
+    :func:`reaching_entrypoints` for the verdict.
+    """
+    res = resolve(store, name, kinds=kinds)
+    paths: list[list[str]] = []
+    seen: set[tuple[str, ...]] = set()
+    truncated = False
+    for node_id in res.ids:
+        for path in store.entrypoint_paths_to(node_id, max_depth=_cutoff(max_depth)):
+            key = tuple(path)
+            if key in seen:
+                continue
+            if limit is not None and len(paths) >= limit:
+                truncated = True
+                break
+            seen.add(key)
+            paths.append(path)
+        if truncated:
+            break
+    paths.sort(key=lambda p: (len(p), p))
+    return paths, res, truncated
+
+
+def paths_between(
+    store: GraphStore,
+    src: str,
+    dst: str,
+    *,
+    max_depth: int = 20,
+) -> tuple[list[list[str]], Resolution, Resolution]:
+    """All call paths from any variant of ``src`` to any variant of ``dst``."""
+    src_res = resolve(store, src)
+    dst_res = resolve(store, dst)
+    paths: list[list[str]] = []
+    seen: set[tuple[str, ...]] = set()
+    for s in src_res.ids:
+        for d in dst_res.ids:
+            if s == d:
+                continue
+            for path in store.paths_between(s, d, _cutoff(max_depth)):
+                key = tuple(path)
+                if key not in seen:
+                    seen.add(key)
+                    paths.append(path)
+    paths.sort(key=lambda p: (len(p), p))
+    return paths, src_res, dst_res
+
+
+def neighbors(
+    store: GraphStore,
+    name: str,
+    *,
+    direction: str,
+) -> tuple[list[str], Resolution]:
+    """Direct callers (``direction="in"``) or callees (``"out"``) across all variants."""
+    if direction not in ("in", "out"):
+        raise ValueError(f"direction must be 'in' or 'out', got {direction!r}")
+    res = resolve(store, name)
+    out: set[str] = set()
+    for node_id in res.ids:
+        units = store.callers_of(node_id) if direction == "in" else store.callees_of(node_id)
+        out.update(u.id for u in units)
+    return sorted(out - set(res.ids)), res
+
+
+def closure(
+    store: GraphStore,
+    name: str,
+    *,
+    direction: str,
+) -> tuple[list[str], Resolution]:
+    """Transitive ancestors (``"in"``) or reachable set (``"out"``) across all variants."""
+    if direction not in ("in", "out"):
+        raise ValueError(f"direction must be 'in' or 'out', got {direction!r}")
+    res = resolve(store, name)
+    out: set[str] = set()
+    for node_id in res.ids:
+        if direction == "in":
+            out.update(store.ancestors_of(node_id))
+        else:
+            out.update(store.reachable_from(node_id))
+    return sorted(out - set(res.ids)), res
+
+
+def state_access(
+    store: GraphStore,
+    name: str,
+    *,
+    mode: str,
+) -> tuple[list[str], Resolution]:
+    """State variables a function ``"reads"`` or ``"writes"``, across all variants.
+
+    Solidity-only (the state web lives on the Solidity parser). Returns state-variable
+    node ids.
+    """
+    if mode not in ("reads", "writes"):
+        raise ValueError(f"mode must be 'reads' or 'writes', got {mode!r}")
+    res = resolve(store, name, kinds=CALLABLE_KINDS)
+    wanted = set(res.ids)
+    out: set[str] = set()
+    for edge in store.graph.edges:
+        if edge.kind.value == mode and edge.source_id in wanted:
+            out.add(edge.target_id)
+    return sorted(out), res

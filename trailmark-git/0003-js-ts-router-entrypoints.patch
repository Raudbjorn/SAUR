+# JS/TS — router registration at a call site:
+#   `app.get("/path", handler)` / `router.post('/x', mw, handler)`
+# Hono, Express, Koa (@koa/router), Fastify and their many clones all
+# share this shape. Requiring a string-literal first argument *and* a
+# following argument is what keeps this from matching `map.get("k")` or
+# `headers.get("x")`, which take a single argument.
+_JS_ROUTER_CALL = re.compile(
+    r"\b[A-Za-z_$][\w$]*\s*\.\s*"
+    r"(?:get|post|put|patch|delete|head|options|all|use)\s*\(\s*"
+    r"[\"'`][^\"'`]*[\"'`]\s*,\s*(?P<rest>[^)]*)",
+)
+
+# A router argument that names an existing function, as opposed to an
+# inline callback. Bare (`handler`) or dotted (`ctrl.handler`).
+_JS_ROUTER_ARG = re.compile(r"^[A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)*$")
+

+class TestJsRouter:
+    """Call-site route registration shared by Hono, Express, Koa, Fastify."""
+
+    def test_hono_named_handler_detected(self, tmp_path: Path) -> None:
+        (tmp_path / "app.ts").write_text(
+            'import { Hono } from "hono";\n'
+            "\n"
+            "const app = new Hono();\n"
+            'app.get("/health", healthHandler);\n'
+            "\n"
+            "export function healthHandler(c: any) { return c.text('ok'); }\n"
+        )
+        engine = QueryEngine.from_directory(str(tmp_path), language="typescript")
+        surface = engine.attack_surface()
+        ids = {ep["node_id"] for ep in surface}
+        descriptions = {ep.get("description") or "" for ep in surface}
+        assert any("healthHandler" in nid for nid in ids), surface
+        assert any("JS/TS router handler" in d for d in descriptions), surface
+
+    def test_express_handler_detected(self, tmp_path: Path) -> None:
+        (tmp_path / "server.js").write_text(
+            'const express = require("express");\n'
+            "const app = express();\n"
+            'app.post("/login", loginHandler);\n'
+            "\n"
+            "function loginHandler(req, res) { return res.end(); }\n"
+        )
+        engine = QueryEngine.from_directory(str(tmp_path), language="javascript")
+        ids = {ep["node_id"] for ep in engine.attack_surface()}
+        assert any("loginHandler" in nid for nid in ids), ids
+
+    def test_middleware_chain_tags_every_named_argument(self, tmp_path: Path) -> None:
+        (tmp_path / "app.ts").write_text(
+            "const app = new Hono();\n"
+            'app.get("/users", requireAuth, listUsers);\n'
+            "\n"
+            "export function requireAuth(c: any) { return c; }\n"
+            "export function listUsers(c: any) { return c; }\n"
+        )
+        engine = QueryEngine.from_directory(str(tmp_path), language="typescript")
+        ids = {ep["node_id"] for ep in engine.attack_surface()}
+        assert any("requireAuth" in nid for nid in ids), ids
+        assert any("listUsers" in nid for nid in ids), ids
+
+    def test_single_argument_get_is_not_a_route(self, tmp_path: Path) -> None:
+        """`map.get("key")` must not tag a same-named function."""
+        (tmp_path / "app.ts").write_text(
+            "const cache = new Map();\n"
+            "export function key(c: any) { return c; }\n"
+            'const value = cache.get("key");\n'
+        )
+        engine = QueryEngine.from_directory(str(tmp_path), language="typescript")
+        ids = {ep["node_id"] for ep in engine.attack_surface()}
+        assert not any("key" in nid for nid in ids), ids
+
+    def test_inline_arrow_callback_is_not_detected(self, tmp_path: Path) -> None:
+        """Documents a known limit: inline callbacks create no node to tag."""
+        (tmp_path / "app.ts").write_text(
+            'const app = new Hono();\napp.get("/x", async (c) => { return c.text("hi"); });\n'
+        )
+        engine = QueryEngine.from_directory(str(tmp_path), language="typescript")
+        assert engine.attack_surface() == []
+

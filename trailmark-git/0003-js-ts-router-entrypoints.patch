+    def js_router_handler_names(self, path: str) -> set[str]:
+        """Extract JS/TS handler names registered on a router in the file.
+
+        Scans for ``<router>.<verb>("/path", handler)`` as used by Hono,
+        Express, Koa and Fastify. Every argument after the path that is a
+        bare or dotted identifier is recorded, so middleware chains like
+        ``app.get("/x", requireAuth, listUsers)`` contribute both names;
+        the last dotted segment is kept for lookup against Trailmark node
+        names.
+
+        Only *named* handlers are captured. An inline callback --
+        ``app.get("/x", async (c) => { ... })`` -- creates no node in the
+        graph, so there is nothing to tag. This is a real coverage limit,
+        not an oversight.
+        """
+        key = f"js_router::{path}"
+        cached = self._scan_cache.get(key)
+        if cached is not None:
+            return cached
+        names: set[str] = set()
+        for line in self._read(path):
+            for match in _JS_ROUTER_CALL.finditer(line):
+                for argument in match.group("rest").split(","):
+                    candidate = argument.strip()
+                    if _JS_ROUTER_ARG.match(candidate):
+                        names.add(candidate.rsplit(".", 1)[-1])
+        self._scan_cache[key] = names
+        return names
+

+# Extensions a relative JS/TS specifier may resolve to, in the order the
+# TypeScript and Node ESM resolvers try them.
+_JS_MODULE_SUFFIXES = (".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs")
+
+# ESM/NodeNext requires import specifiers to carry the *emitted* extension,
+# so `./foo.js` routinely refers to `foo.ts` on disk.
+_JS_EMITTED_TO_SOURCE = {
+    ".js": (".ts", ".tsx"),
+    ".mjs": (".mts",),
+    ".cjs": (".cts",),
+    ".jsx": (".tsx",),
+}
+
+
+def resolve_relative_module_id(importer_path: str, specifier: str) -> str | None:
+    """Resolve a relative JS/TS import specifier to a module ID.
+
+    Returns ``None`` -- meaning "do not emit an import edge" -- unless all
+    of the following hold:
+
+    - the specifier is relative (``./x`` or ``../x``). Bare specifiers name
+      external packages, which belong in ``graph.dependencies`` rather than
+      as graph edges pointing at nodes that will never exist;
+    - a directory parse is in progress. Single-file parsing derives module
+      IDs from the bare filename stem, so a cross-file edge could not
+      address anything;
+    - the specifier resolves to a file that actually exists on disk and
+      lies under the directory-parse root.
+
+    The returned ID comes from :func:`module_id_from_path`, so it matches
+    the MODULE node the target file produces, escaping included.
+    """
+    if not specifier.startswith("."):
+        return None
+    root = _DIRECTORY_PARSE_ROOT.get()
+    if root is None:
+        return None
+
+    base = _absolute_lexical_path(Path(importer_path)).parent
+    target = Path(os.path.normpath(base / specifier))
+
+    resolved = _first_existing_module_file(target)
+    if resolved is None:
+        return None
+    try:
+        resolved.relative_to(root)
+    except ValueError:
+        return None
+    return module_id_from_path(str(resolved))
+
+
+def _first_existing_module_file(target: Path) -> Path | None:
+    """Return the first on-disk file a resolved specifier can refer to."""
+    if target.is_file():
+        return target
+    for suffix in _JS_MODULE_SUFFIXES:
+        candidate = target.with_name(target.name + suffix)
+        if candidate.is_file():
+            return candidate
+    for source_suffix in _JS_EMITTED_TO_SOURCE.get(target.suffix, ()):
+        candidate = target.with_suffix(source_suffix)
+        if candidate.is_file():
+            return candidate
+    for suffix in _JS_MODULE_SUFFIXES:
+        candidate = target / f"index{suffix}"
+        if candidate.is_file():
+            return candidate
+    return None
+
+
+def add_import_edge(
+    graph: CodeGraph,
+    module_id: str,
+    importer_path: str,
+    specifier: str,
+) -> None:
+    """Add a MODULE -> MODULE IMPORTS edge for a relative specifier.
+
+    No-op for anything :func:`resolve_relative_module_id` declines, for
+    self-imports, and for a specifier already recorded for this module --
+    re-importing the same file on several lines is one dependency, not
+    several edges.
+    """
+    target_id = resolve_relative_module_id(importer_path, specifier)
+    if target_id is None or target_id == module_id:
+        return
+    for edge in graph.edges:
+        if (
+            edge.kind == EdgeKind.IMPORTS
+            and edge.source_id == module_id
+            and edge.target_id == target_id
+        ):
+            return
+    graph.edges.append(CodeEdge(source_id=module_id, target_id=target_id, kind=EdgeKind.IMPORTS))
+
+
 _EXCLUDED_DIRS = frozenset(
     {
         ".git",

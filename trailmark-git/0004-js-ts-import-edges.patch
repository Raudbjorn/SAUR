diff --git a/tests/test_common_parser.py b/tests/test_common_parser.py
index 49af2a6..99679e7 100644
--- a/tests/test_common_parser.py
+++ b/tests/test_common_parser.py
@@ -319,3 +319,100 @@ def test_cross_file_linker_keeps_ambiguous_cross_file_calls_unresolved(
     assert len(call_edges) == 1
     assert call_edges[0].target_id == "proxy.unresolved:ambiguous_caller:shared_name"
     assert call_edges[0].confidence == EdgeConfidence.UNCERTAIN
+
+
+# ── Relative-import resolution (JS / TS) ─────────────────────────
+
+
+def _ts_import_edges(root: Path) -> set[tuple[str, str]]:
+    """Parse ``root`` as TypeScript and return its IMPORTS edges."""
+    from trailmark.parse import parse_directory as parse_tree
+
+    graph = parse_tree(str(root), "typescript")
+    return {(e.source_id, e.target_id) for e in graph.edges if e.kind == EdgeKind.IMPORTS}
+
+
+def test_relative_import_creates_module_edge(tmp_path: Path) -> None:
+    (tmp_path / "lib").mkdir()
+    (tmp_path / "lib" / "crypto.ts").write_text("export function seal(): void {}\n")
+    (tmp_path / "app.ts").write_text('import { seal } from "./lib/crypto";\n')
+
+    assert ("app", "lib.crypto") in _ts_import_edges(tmp_path)
+
+
+def test_bare_specifier_creates_no_edge(tmp_path: Path) -> None:
+    """External packages belong in dependencies, not as dangling edges."""
+    (tmp_path / "app.ts").write_text('import { Hono } from "hono";\n')
+
+    assert _ts_import_edges(tmp_path) == set()
+
+
+def test_unresolvable_relative_import_creates_no_edge(tmp_path: Path) -> None:
+    (tmp_path / "app.ts").write_text('import { gone } from "./missing";\n')
+
+    assert _ts_import_edges(tmp_path) == set()
+
+
+def test_directory_import_resolves_to_index_file(tmp_path: Path) -> None:
+    (tmp_path / "lib").mkdir()
+    (tmp_path / "lib" / "index.ts").write_text("export function seal(): void {}\n")
+    (tmp_path / "app.ts").write_text('import { seal } from "./lib";\n')
+
+    assert ("app", "lib.index") in _ts_import_edges(tmp_path)
+
+
+def test_emitted_js_extension_resolves_to_typescript_source(tmp_path: Path) -> None:
+    """NodeNext ESM writes `./x.js` for a file that is `x.ts` on disk."""
+    (tmp_path / "helper.ts").write_text("export function help(): void {}\n")
+    (tmp_path / "app.ts").write_text('import { help } from "./helper.js";\n')
+
+    assert ("app", "helper") in _ts_import_edges(tmp_path)
+
+
+def test_re_export_creates_import_edge(tmp_path: Path) -> None:
+    (tmp_path / "helper.ts").write_text("export function help(): void {}\n")
+    (tmp_path / "app.ts").write_text('export { help } from "./helper";\n')
+
+    assert ("app", "helper") in _ts_import_edges(tmp_path)
+
+
+def test_repeated_import_of_same_module_yields_one_edge(tmp_path: Path) -> None:
+    """``_ts_import_edges`` returns a set, which would hide a duplicate edge
+    even if ``add_import_edge`` appended one twice -- count raw graph edges
+    instead so this can actually fail."""
+    from trailmark.parse import parse_directory as parse_tree
+
+    (tmp_path / "helper.ts").write_text("export function a(): void {}\n")
+    (tmp_path / "app.ts").write_text(
+        'import { a } from "./helper";\nimport type { B } from "./helper";\n'
+    )
+
+    graph = parse_tree(str(tmp_path), "typescript")
+    edges = [
+        e
+        for e in graph.edges
+        if e.kind == EdgeKind.IMPORTS and (e.source_id, e.target_id) == ("app", "helper")
+    ]
+    assert len(edges) == 1
+
+
+def test_import_outside_parse_root_creates_no_edge(tmp_path: Path) -> None:
+    """A file above the parsed root has no MODULE node to point at."""
+    (tmp_path / "outside.ts").write_text("export function out(): void {}\n")
+    inner = tmp_path / "inner"
+    inner.mkdir()
+    (inner / "app.ts").write_text('import { out } from "../outside";\n')
+
+    assert _ts_import_edges(inner) == set()
+
+
+def test_single_file_parse_creates_no_import_edge(tmp_path: Path) -> None:
+    """Single-file module IDs are bare stems, so cross-file edges cannot address."""
+    from trailmark.parse import parse_file
+
+    (tmp_path / "helper.ts").write_text("export function help(): void {}\n")
+    app = tmp_path / "app.ts"
+    app.write_text('import { help } from "./helper";\n')
+
+    graph = parse_file(str(app), "typescript")
+    assert [e for e in graph.edges if e.kind == EdgeKind.IMPORTS] == []

package_protobuf-git() {
  # NOTE: abseil-cpp bumps its library soname on every release and exposes no
  # versioned `provides`, so pacman cannot enforce ABI coupling via
  # a version pin. Whenever abseil-cpp(-git) is upgraded, protoc/libprotobuf will
  # reference a vanished soname (e.g. libabsl_log_initialize.so.2508.0.0 -> not
  # found) until protobuf-git is rebuilt. Rebuild this package after every abseil
  # update (or rebuild against a compat shim).
  depends=('glibc' 'libgcc' 'libstdc++' 'abseil-cpp' 'zlib')
  provides=("protobuf=$pkgver" 'libprotoc.so' 'libprotobuf.so' 'libprotobuf-lite.so')
  conflicts=('protobuf')

  cd "protobuf"

  DESTDIR="$pkgdir" cmake --install "_build"
  install -Dm644 "LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 "editors/protobuf-mode.el" -t "$pkgdir/usr/share/emacs/site-lisp"
  install -Dm644 "editors/proto.vim" -t "$pkgdir/usr/share/vim/vimfiles/syntax"
}

package_python-protobuf-git() {
  pkgdesc="Python 3 bindings for Google Protocol Buffers"
  depends=("protobuf-git=$pkgver" 'python')
  optdepends=('python-numpy: numpy.asarray() on repeated scalar fields')
  provides=("python-protobuf=$pkgver")
  conflicts=('python-protobuf')

  cd "protobuf"

  install -Dm644 "LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"

  python \
    -m installer \
    --destdir="$pkgdir" \
    "$srcdir/python-dist/dist/"*.whl
}

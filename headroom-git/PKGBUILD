pkgname=headroom-git
pkgver=0.32.0.r2319.gc400f90
pkgrel=1
pkgdesc='Context optimization layer for LLM applications (full-feature VCS build)'
arch=('x86_64')
url='https://github.com/headroomlabs-ai/headroom'
license=('Apache-2.0')
# Upstream excludes the compromised PyPI ast-grep-cli 0.44.1 wheel. Arch's
# ast-grep is independently built from the Rust source and is not that artifact.
# LiteLLM is omitted because upstream restricts it to Python <3.14 while Arch
# currently ships Python 3.14.
# Direct imports are declared even when upstream currently receives them transitively.
depends=(
  'ast-grep>=0.30'
  'python>=3.10'
  'python-anthropic>=0.18'
  'python-click>=8.3.3'
  'python-datasets>=2.14'
  'python-fastapi>=0.100'
  'python-fastembed>=0.4'
  'python-h2'
  'python-httpx>=0.24'
  'python-huggingface-hub>=1:1.5'
  'python-huggingface-hub<1:2'
  'python-jinja>=3'
  'python-magika>=0.6'
  'python-mcp>=1.28.1'
  'python-numpy>=1.24'
  'python-onnxruntime>=1.16'
  'python-onnxruntime<2'
  'python-openai>=2.14'
  'python-openpyxl>=3.1'
  'python-opentelemetry-api>=1.24'
  'python-opentelemetry-exporter-otlp-proto-http>=1.24'
  'python-opentelemetry-sdk>=1.24'
  'python-orjson>=3.9.14'
  'python-packaging'
  'python-pillow>=12.3'
  'python-pydantic>=2'
  'python-pytorch>=2.12.1'
  'python-rapidocr>=3'
  'python-rapidocr<4'
  'python-rich>=13'
  'python-safetensors'
  'python-scikit-learn>=1.3'
  'python-sentence-transformers>=2.2'
  'python-sentence-transformers<6'
  'python-sentencepiece>=0.1.99'
  'python-sqlite-vec>=0.1.6'
  'python-starlette>=0.27'
  'python-tiktoken>=0.5'
  'python-tokenizers'
  'python-tomlkit>=0.13'
  'python-tomlkit<1'
  'python-trafilatura>=1.6'
  'python-transformers>=5.5'
  'python-transformers<6'
  'python-tree-sitter>=0.25.2'
  'python-tree-sitter<0.27'
  'python-tree-sitter-language-pack>=0.10'
  'python-tree-sitter-language-pack<1'
  'python-watchdog>=4'
  'python-websockets>=13'
  'python-xlrd>=2'
  'python-yaml>=6'
  'python-zstandard>=0.20'
  'uvicorn>=0.23'
  'uvicorn<1'
)
makedepends=(
  'git'
  'maturin'
  'python-installer'
  'rust'
)
provides=("headroom-ai=$pkgver")
conflicts=('headroom-ai' 'headroom')
source=('headroom-src::git+https://github.com/headroomlabs-ai/headroom.git')
sha256sums=('SKIP')

pkgver() {
  cd headroom-src

  local _version
  _version=$(awk -F'"' '/^version = "/ { print $2; exit }' pyproject.toml)
  printf '%s.r%s.g%s' \
    "$_version" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd headroom-src

  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked
}

build() {
  cd headroom-src

  export CARGO_HOME="$srcdir/cargo-home"
  rm -rf dist
  RUSTFLAGS+=" --remap-path-prefix=$srcdir=/usr/src/debug/$pkgbase"
  CFLAGS+=" -fno-lto" CXXFLAGS+=" -fno-lto" \
    maturin build --release --locked --offline --strip --out dist
}

package() {
  cd headroom-src

  python -m installer --destdir="$pkgdir" dist/*.whl

  local _sbom _record
  _sbom=("$pkgdir"/usr/lib/python*/site-packages/headroom_ai-*.dist-info/sboms/headroom-py.cyclonedx.json)
  _record="${_sbom[0]%/sboms/*}/RECORD"
  sed -i "s|$srcdir/headroom-src|/usr/src/debug/$pkgbase|g" "${_sbom[0]}"
  sed -i '\|sboms/headroom-py.cyclonedx.json,|s|,sha256=[^,]*,[0-9]*$|,,|' "$_record"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}

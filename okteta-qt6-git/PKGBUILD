pkgname=okteta-qt6-git
pkgver=0.26.28.r1578.g17be3ce
pkgrel=1
pkgdesc='KDE hex editor for viewing and editing the raw data of files (Qt6 git version)'
arch=(x86_64)
url='https://apps.kde.org/okteta/'
license=(GPL-2.0-only GPL-3.0-only LGPL-2.1-only LGPL-3.0-only
         LicenseRef-KDE-Accepted-GPL LicenseRef-KDE-Accepted-LGPL GFDL-1.2-or-later)
depends=('qt6-base'
         'qt6-declarative'
         'qt6-5compat'
         'kcolorscheme'
         'kcompletion'
         'kconfig'
         'kconfigwidgets'
         'kcoreaddons'
         'kcrash'
         'kdbusaddons'
         'ki18n'
         'kio'
         'kparts'
         'kwidgetsaddons'
         'kxmlgui'
         'hicolor-icon-theme'
         'bzip2'
         'xz'
         'zlib'
         'zstd'
)
makedepends=('git'
             'ninja'
             'cmake'
             'extra-cmake-modules'
             'kdoctools'
             'qt6-tools'
             # Required by find_package(), but not linked directly
             'kbookmarks'
             'kitemviews'
             'kservice'
             'shared-mime-info'
)
provides=(okteta)
conflicts=(okteta)
source=("okteta::git+https://invent.kde.org/utilities/okteta.git#branch=work/kossebau/kf6"
)
sha256sums=(SKIP
)

prepare() {
    cd okteta

    # The port branch lags behind master (mostly translation syncs), so replay
    # its commits on top of current master. Committer identity/date are taken
    # from the original commits to keep the resulting hashes reproducible.
    local port_head commit
    port_head=$(git rev-parse HEAD)
    git checkout -q --detach origin/master
    for commit in $(git rev-list --reverse origin/master.."$port_head"); do
        if ! GIT_COMMITTER_NAME="$(git log -1 --format=%cn "$commit")" \
             GIT_COMMITTER_EMAIL="$(git log -1 --format=%ce "$commit")" \
             GIT_COMMITTER_DATE="$(git log -1 --format=%cI "$commit")" \
             git cherry-pick --allow-empty "$commit" >/dev/null; then
            echo "==> WARNING: Port does not apply on master, building the port branch as-is" >&2
            git cherry-pick --abort
            git checkout -q --detach "$port_head"
            break
        fi
    done
}

pkgver() {
    git -C okteta describe --long --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
    cmake \
        -B build \
        -S okteta \
        -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=OFF
    # Ninja ignores MAKEFLAGS, so forward its job count from makepkg.conf
    local jobs
    jobs=$(grep -oP -- '-j\s*\K[0-9]+' <<< "$MAKEFLAGS")
    cmake --build build ${jobs:+--parallel "$jobs"}
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" okteta/LICENSES/LicenseRef-*.txt
}

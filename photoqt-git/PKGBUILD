# Maintainer: Sveinbjörn Geirsson <sveinbjorn@massif.network>
# Contributor: Lukas Spies <lukas (at) photoqt _dot_ org>
# Contributor: archtux <antonio dot arias99999 at gmail dot com>

pkgname=photoqt-git
_pkgname=photoqt
pkgver=5.4.1.r14.g7d35e6f
pkgrel=1
pkgdesc='Fast and highly configurable image viewer with a simple and nice interface'
arch=('x86_64')
url='https://photoqt.org/'
license=('GPL-2.0-or-later')
depends=(
  'exiv2' 'ffmpegthumbnailer' 'glibc' 'hicolor-icon-theme' 'imagemagick' 'kimageformats'
  'lcms2' 'libarchive' 'libgcc' 'libraw' 'libstdc++' 'mpv' 'openmp' 'openslide' 'openssl'
  'python-pychromecast' 'qt6-base' 'qt6-declarative' 'qt6-imageformats' 'qt6-location'
  'qt6-multimedia' 'qt6-positioning' 'qt6-quick3d' 'qt6-svg' 'qt6-webengine' 'resvg'
  'wayland' 'yaml-cpp' 'zxing-cpp'
)
makedepends=('git' 'cmake' 'ninja' 'qt6-tools' 'extra-cmake-modules')
optdepends=('photoqt-extensions: official extensions (photoqt-extensions-git satisfies this)')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname" 'photoqt-bin' 'photoqt-bin-debug')
source=("$_pkgname::git+https://gitlab.com/lspies/photoqt.git#branch=master")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  # Ninja ignores MAKEFLAGS; carry its -jN over so deliberate throttling is respected.
  local _jobs
  _jobs=$(grep -oP '(?<=-j)\s*\d+' <<< "$MAKEFLAGS" | tr -d ' ')
  export CMAKE_BUILD_PARALLEL_LEVEL="${_jobs:-$(nproc)}"

  # Disabled backends: DevIL, Poppler (QtPDF is used instead), libvips, libsai,
  # GraphicsMagick (mutually exclusive with ImageMagick) and pugixml.
  cmake -S "$_pkgname" -B build -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DWITH_DEVIL=OFF \
    -DWITH_POPPLER=OFF \
    -DWITH_QTPDF=ON \
    -DWITH_IMAGEMAGICK=ON \
    -DWITH_GRAPHICSMAGICK=OFF \
    -DWITH_LIBVIPS=OFF \
    -DWITH_VIDEO_MPV=ON \
    -DWITH_CHROMECAST=ON \
    -DWITH_RESVG=ON \
    -DWITH_ZXING=ON \
    -DWITH_LCMS2=ON \
    -DWITH_LIBSAI=OFF \
    -DWITH_OPENSLIDE=ON \
    -DWITH_EXTENSIONS_SUPPORT=ON \
    -DWITH_PUGIXML=OFF \
    -DWITH_FFMPEGTHUMBNAILER=ON
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}

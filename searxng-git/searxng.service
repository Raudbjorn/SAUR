[Unit]
Description=SearXNG metasearch engine
Documentation=https://docs.searxng.org/
After=network-online.target valkey.service
Wants=network-online.target valkey.service

[Service]
Type=exec
User=searxng
Group=searxng
WorkingDirectory=/var/lib/searxng

Environment=LANG=C.UTF-8
Environment=LANGUAGE=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=SEARXNG_SETTINGS_PATH=/etc/searxng/settings.yml
# Base URL of a self-hosted searxico favicon worker; see favicons.toml.
Environment=SEARXICO_BASE_URL=

# Granian is the production WSGI server upstream is migrating to; searxng-run
# is Flask's development server and is explicitly not meant for production use.
# Override any of these with a drop-in: systemctl edit searxng.service
Environment=GRANIAN_INTERFACE=wsgi
Environment=GRANIAN_PROCESS_NAME=searxng
Environment=GRANIAN_HOST=127.0.0.1
Environment=GRANIAN_PORT=8888
Environment=GRANIAN_WEBSOCKETS=false
Environment=GRANIAN_BLOCKING_THREADS=4
Environment=GRANIAN_WORKERS_KILL_TIMEOUT=30s
Environment=GRANIAN_BLOCKING_THREADS_IDLE_TIMEOUT=5m
ExecStart=/var/lib/searxng/venv/bin/granian searx.webapp:app

Restart=on-failure
RestartSec=5

# Hardening. The engine and favicon caches default to tempfile.gettempdir(),
# which PrivateTmp makes a private, writable per-service directory.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
# the favicon cache is the only thing the service writes
ReadWritePaths=/var/cache/searxng/favicons
ProtectHome=yes
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target

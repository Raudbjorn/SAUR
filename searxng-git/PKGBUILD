pkgver() {
  cd "$_pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  # Route Anna's Archive requests through a DDoS-Guard clearance minted by
  # searxng-annas-ddg-refresh; without it every mirror answers 403 and the
  # engine silently reports zero results.
  patch -d "$_pkgname" -p1 -i "$srcdir/annas-archive-ddg-clearance.patch"

  # Upstream lets extract_text(allow_none=True) put None into content,
  # publisher and authors. The result container normalizes those with a regex
  # and raises TypeError, dropping the engine's entire response.
  patch -d "$_pkgname" -p1 -i "$srcdir/annas-archive-none-fields.patch"

  # The patch ADDS files; makepkg's reset restores tracked files but leaves
  # untracked ones behind, so a rerun after a failed build would hit
  # "file already exists". Clear them first to keep prepare() idempotent.
  git -C searxng-bm25-reranker clean -xfdq
  patch -d searxng-bm25-reranker -p1 -i "$srcdir/bm25-reranker-query-constraints.patch"

  # Work on a real copy: makepkg symlinks local sources into $srcdir and we do
  # not want to touch the files tracked in the packaging repository.
  # The secret_key placeholder is deliberately left intact: post_install
  # replaces it per machine (see searxng.install). Generating it here would ship
  # one shared key inside the package and rotate it on every rebuild.
  cp -f "$srcdir/settings.yml" "$srcdir/settings.yml.build"

}

build() {
  cd "$_pkgname"

  # the oneAPI profile exports PYTHONPATH; it must not leak into the build
  unset PYTHONPATH

  export SEARXNG_SETTINGS_PATH="$srcdir/settings.yml.build"
  python -m searx.version freeze
  sed -i "s|GIT_URL =.*|GIT_URL = \"${_giturl}\"|g" searx/version_frozen.py
  sed -i "s|GIT_BRANCH =.*|GIT_BRANCH = \"${_gitbranch}\"|g" searx/version_frozen.py

  # ---- Timetable theme -------------------------------------------------
  # The whole look is a token file plus one override layer; no template is
  # forked, so upstream's markup stays authoritative and rebases stay cheap.
  printf "  -> %s\n" "applying the Timetable theme"
  install -Dm644 "$srcdir/timetable-definitions.less" client/simple/src/less/definitions.less
  install -Dm644 "$srcdir/timetable.less" client/simple/src/less/themes/timetable/timetable.less
  install -Dm644 "$srcdir/timetable-fonts.less" client/simple/src/less/themes/timetable/fonts.less

  # vite's publicDir is copied verbatim beside the built stylesheet, so the
  # font files resolve as plain siblings of the CSS
  install -Dm644 "$srcdir/archivo-latin.woff2" client/simple/static/archivo-latin.woff2
  install -Dm644 "$srcdir/archivo-latin-ext.woff2" client/simple/static/archivo-latin-ext.woff2
  install -Dm644 "$srcdir/archivo-vietnamese.woff2" client/simple/static/archivo-vietnamese.woff2

  # imported last so the layer wins the cascade
  grep -q 'themes/timetable/timetable.less' client/simple/src/less/style.less || \
    echo '@import "themes/timetable/timetable.less";' >> client/simple/src/less/style.less

  printf "  -> %s\n" "rebuilding the client stylesheet"
  ( cd client/simple
    npm install --no-audit --no-fund --ignore-scripts
    npx vite build )

  # the plugin is pure python with no runtime deps; build its wheel with the
  # system interpreter so setuptools does not have to exist inside the venv
  ( cd "$srcdir/searxng-bm25-reranker" && rm -rf dist && python -m build --no-isolation --wheel )

  # generate the wheel using the system python-build.
  # dist/ must be emptied first: makepkg reuses $srcdir, so a wheel from an
  # earlier commit would still be there and `dist/*.whl` would match both.
  rm -rf dist
  python -m build --no-isolation --wheel
}

package() {
  cd "$_pkgname"

  unset PYTHONPATH

  local _venv="$pkgdir/var/lib/searxng/venv"

  # uv resolves and installs the whole dependency set in parallel; copy link
  # mode keeps the payload independent of ~/.cache/uv so that makepkg's strip
  # stage cannot write through a hardlink into the cache.
  export UV_LINK_MODE=copy
  export UV_NO_PROGRESS=1
  export UV_PYTHON_DOWNLOADS=never
  export UV_CONCURRENT_BUILDS="$(nproc)"
  export UV_CONCURRENT_INSTALLS="$(nproc)"

  uv venv --no-project --python "$(command -v python)" "$_venv"

  # runtime requirements + the production WSGI server (granian) + searxng itself
  uv pip install --python "$_venv/bin/python" \
    --requirement requirements.txt \
    --requirement requirements-server.txt \
    dist/*.whl "$srcdir"/searxng-bm25-reranker/dist/*.whl

  # Custom favicon resolver, registered by favicons.toml's resolver_map. It is
  # a plain module rather than a patch, so nothing has to be rebased upstream.
  install -Dm644 "$srcdir/searxng_searxico.py" \
    "$("$_venv/bin/python" -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/searxng_searxico.py"

  # installer metadata records the wheel's location under $srcdir
  find "$_venv" -name 'direct_url.json' -delete

  # remove references to pkgdir from generated scripts and venv metadata
  find "$_venv/bin" -maxdepth 1 -type f -exec sed -i "s|${pkgdir}||g" {} +
  sed -i "s|${pkgdir}||g" "$_venv/pyvenv.cfg"

  # Pre-compile with the final (installed) paths baked into the bytecode, in
  # parallel across all cores. unchecked-hash avoids mtime-based invalidation,
  # which would otherwise make the read-only service user recompile on import.
  # -f is required: uv pre-compiles its own _virtualenv.py shim at venv
  # creation time, and without forcing, compileall leaves that stale $pkgdir
  # path in the bytecode.
  "$_venv/bin/python" -m compileall -q -f -j 0 \
    --invalidation-mode unchecked-hash \
    -s "$pkgdir" -p / "$_venv/lib" || true

  # executable
  install -d "$pkgdir/usr/bin"
  ln -s "/var/lib/searxng/venv/bin/searxng-run" "$pkgdir/usr/bin/searxng-run"

  # configuration files
  # modes match searxng.tmpfiles so pacman does not warn about differing
  # directory permissions on every upgrade
  install -dm750 "$pkgdir/etc/searxng" "$pkgdir/var/lib/searxng"
  install -Dm644 "$srcdir/settings.yml.build" "$pkgdir/etc/searxng/settings.yml"
  install -Dm644 "searx/limiter.toml" "$pkgdir/etc/searxng/limiter.toml"
  install -Dm644 "$srcdir/favicons.toml" "$pkgdir/etc/searxng/favicons.toml"
  # The bundled bm25 reranker plugin is AGPL-3.0-or-later too, and ships no
  # LICENSE file of its own (pyproject declares only the SPDX id), so the
  # searxng LICENSE installed here covers both.
  # $pkgname, not "searxng": pacman and namcap both look under the package name,
  # so licences installed under a different directory are not found at all.
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/LICENSE.archivo-ofl" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.archivo-OFL-1.1"
  # uv leaves the venv lock mode 0666; nothing should be able to write into a
  # packaged tree, and namcap flags it.
  [ -e "$pkgdir/var/lib/searxng/venv/.lock" ] && chmod 0644 "$pkgdir/var/lib/searxng/venv/.lock"

  install -Dm644 "$srcdir/searxng.sysusers" "$pkgdir/usr/lib/sysusers.d/searxng.conf"
  install -Dm644 "$srcdir/searxng.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/searxng.conf"
  install -Dm644 "$srcdir/searxng.service" "$pkgdir/usr/lib/systemd/system/searxng.service"

  # Anna's Archive DDoS-Guard clearance refresher (needs FlareSolverr)
  install -Dm755 "$srcdir/searxng-annas-ddg-refresh" "$pkgdir/usr/bin/searxng-annas-ddg-refresh"
  install -Dm644 "$srcdir/searxng-annas-ddg-refresh.service" \
    "$pkgdir/usr/lib/systemd/system/searxng-annas-ddg-refresh.service"
  install -Dm644 "$srcdir/searxng-annas-ddg-refresh.timer" \
    "$pkgdir/usr/lib/systemd/system/searxng-annas-ddg-refresh.timer"

  # documentation
  install -Dm644 "$srcdir/searxng.example.com.conf" \
    "$pkgdir/usr/share/doc/searxng/searxng.example.com.conf"
}

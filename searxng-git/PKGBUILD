pkgname=searxng-git
_pkgname=searxng
pkgver=r9782.2e624be
pkgrel=1
pkgdesc="A privacy-respecting, hackable metasearch engine"
# not 'any': the bundled venv ships compiled extensions (lxml, msgspec,
# curl_cffi, granian) built for this architecture and CPython ABI.
arch=('x86_64')
url="https://searxng.github.io/searxng/"
# AGPL covers searxng and the bundled bm25 plugin; OFL covers the
# Archivo font files shipped with the Timetable theme
license=('AGPL-3.0-or-later' 'OFL-1.1')
makedepends=('git' 'python-build' 'python-msgspec' 'python-setuptools'
             'python-wheel' 'python-yaml' 'uv'
             # the Timetable theme is a LESS override layer, so the client
             # stylesheet is rebuilt from source with upstream's vite pipeline
             'npm' 'nodejs')
# 'python' is a hard dependency: the venv links against the system interpreter,
# so a CPython minor-version bump requires a rebuild of this package.
depends=('python' 'valkey' 'openssl')
optdepends=('nginx: reverse proxy, see /usr/share/doc/searxng/searxng.example.com.conf'
            'flaresolverr: DDoS-Guard clearance for the Annas Archive engines')
provides=("searxng=${pkgver}")
conflicts=('searx' 'searx-git' 'searxng')
backup=('etc/searxng/settings.yml' 'etc/searxng/limiter.toml' 'etc/searxng/favicons.toml')
install="$pkgname.install"
_giturl="https://github.com/searxng/searxng"
_gitbranch="master"
# BM25 reranking plugin (AGPL-3.0); the patch adds query-constraint boosting
# on top of upstream, vendoring zerodep's query_tools.
_rerankerurl="https://github.com/Oaklight/searxng-bm25-reranker"
_rerankerbranch="main"
source=(git+$_giturl#branch=$_gitbranch
        git+$_rerankerurl#branch=$_rerankerbranch
        'settings.yml'
        'searxng.sysusers'
        'searxng.tmpfiles'
        'searxng.service'
        'searxng.example.com.conf'
        'annas-archive-ddg-clearance.patch'
        'annas-archive-none-fields.patch'
        'searxng-annas-ddg-refresh'
        'searxng-annas-ddg-refresh.service'
        'searxng-annas-ddg-refresh.timer'
        'bm25-reranker-query-constraints.patch'
        'favicons.toml'
        'searxng_searxico.py'
        'timetable-definitions.less'
        'timetable.less'
        'timetable-fonts.less'
        'archivo-latin.woff2'
        'archivo-latin-ext.woff2'
        'archivo-vietnamese.woff2'
        'LICENSE.archivo-ofl')

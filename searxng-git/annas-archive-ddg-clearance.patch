+        params["cookies"] = cookies
+        # Anna's Archive bounces /search once to "&check=1" to verify the
+        # DDoS-Guard cookie.  Online engines do not follow redirects by
+        # default, which would leave us with the 302 body and no results.
+        params["allow_redirects"] = True

diff -urN a/src/searxng_bm25_reranker/_vendor/query_tools.py b/src/searxng_bm25_reranker/_vendor/query_tools.py
--- a/src/searxng_bm25_reranker/_vendor/query_tools.py	1970-01-01 00:00:00.000000000 +0000

+"""Query-constraint boosts for BM25 reranking.
+
+Uses zerodep's ``query_tools`` to pull quoted phrases and ``+required`` terms
+out of the query, then boosts results whose text actually contains them.
+
+Only *presence* is rewarded. Search snippets are short, so a missing phrase
+says little about the page behind it.
+
+Negations (``not X``, ``without X``) are deliberately ignored. The parser
+matches natural-language triggers, so "wifi not working" or "404 not found"
+would demote exactly the results the user wants, and a lexical match cannot
+tell "coffee without caffeine" from "caffeine".
+"""
+
+from __future__ import annotations
+
+import dataclasses
+
+from ._tokenizer import cjk_tokenize
+from ._vendor.query_tools import QueryConstraintParser
+from ._vendor.sparse_search import Result
+
+# BM25 score gain per satisfied constraint (0.5 = +50%).
+CONSTRAINT_BOOST = 0.5
+
+_PARSER = QueryConstraintParser()
+
+
+def _normalize(text: str) -> str:
+    """Lowercase and collapse whitespace so phrases match across line breaks."""
+    return " ".join(text.lower().split())
+
+
+def boost_constraint_matches(
+    results: list[Result], fields: dict[str, tuple[str, ...]], query: str
+) -> list[Result]:
+    """Boost results that contain the query's quoted phrases or +required terms.
+
+    Args:
+        results: BM25 results sorted by descending score (non-negative scores).
+        fields: Document id -> searchable field texts (e.g. title, content).
+            Phrases are matched per field, never across a field boundary.
+        query: Raw user query, before any constraint stripping.
+
+    Returns:
+        ``results`` unchanged when the query has no constraints, otherwise new
+        results re-sorted by boosted score.
+    """
+    constraints = _PARSER.parse(query)
+    phrases = list(filter(None, map(_normalize, constraints.exact_phrases)))
+    required = list(
+        filter(None, (set(cjk_tokenize(t)) for t in constraints.required_terms))
+    )
+    if not phrases and not required:
+        return results
+
+    boosted: list[Result] = []
+    for result in results:
+        doc_fields = fields.get(result.doc_id, ())
+        normalized = [_normalize(f) for f in doc_fields]
+        tokens = {tok for f in doc_fields for tok in cjk_tokenize(f)}
+        matches = sum(any(p in f for f in normalized) for p in phrases)
+        matches += sum(term <= tokens for term in required)
+        boosted.append(
+            dataclasses.replace(
+                result, score=result.score * (1.0 + CONSTRAINT_BOOST * matches)
+            )
+        )
+
+    boosted.sort(key=lambda r: r.score, reverse=True)
+    return boosted

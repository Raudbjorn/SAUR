+export const createStartTeardown = (
+  resources: readonly CleanupResource[],
+  logError: CleanupLogger = (message, cause) => console.error(message, cause)
+): (() => Promise<Error[]>) => {
+  let teardownPromise: Promise<Error[]> | undefined
+
+  return () => {
+    if (teardownPromise) return teardownPromise
+    teardownPromise = (async () => {
+      const errors: Error[] = []
+      for (const resource of resources) {
+        try {
+          await resource.close()
+        } catch (cause) {
+          errors.push(cause instanceof Error ? cause : new Error(String(cause)))
+          logError(`cleanup of ${resource.name} failed:`, cause)
+        }
+      }
+      return errors
+    })()
+    return teardownPromise
   }

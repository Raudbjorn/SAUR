new file mode 100644
index 0000000..eda09da
--- /dev/null
+++ b/test/backend-lifecycle.test.ts
@@ -0,0 +1,806 @@
+/**
+ * `createBackend` owns the engine as soon as it acquires one and must release
+ * every partially-started resource if later initialization fails. The CLI's
+ * `start` path builds on the same guarantee to clean up a native-engine
+ * child, in-flight realtime/cron/retention, and a started HTTP server on
+ * SIGINT/SIGTERM without leaking any of them.
+ *
+ * Two regressions cover the contract:
+ *   1. an intentionally invalid project migration closes the supplied
+ *      engine exactly once and surfaces the migration's error verbatim;
+ *   2. a sub-service that throws on `start()` triggers the same cleanup
+ *      stack in reverse-ownership order (most-recent first), so earlier
+ *      services are still torn down after a later one fails.
+ */
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { acquireBackendAfterPort, acquireEngineHandoff, createStartHandoff, createStartTeardown, runStartGate, runUnknownCommand, ShutdownDuringStartup } from '../src/cli.js'
+import { createBackend, type TinbaseBackend } from '../src/index.js'
+import { createPgliteEngine } from '../src/db/pglite-engine.js'
+import type { DbEngine, EngineResults, EngineTx } from '../src/db/engine.js'
+import type { Database } from '../src/db/database.js'
+import type { RetentionConfig } from '../src/retention/service.js'
+
+// shared state for the vi.mock'd services (test 2). hoisted so vi.mock can
+// reference it before the module is imported.
+const lifecycle = vi.hoisted(() => ({
+  started: [] as string[],
+  stopped: [] as string[],
+  // when set, cron.stop throws — used to exercise the safeLog path while
+  // later cleanup steps must keep running.
+  cronStopError: null as Error | null,
+}))
+
+vi.mock('../src/realtime/engine.js', () => ({
+  RealtimeEngine: class FakeRealtime {
+    constructor(_db: Database, _jwtSecret?: string) {}
+    async start(): Promise<void> {
+      lifecycle.started.push('realtime')
+    }
+    stop(): void {
+      lifecycle.stopped.push('realtime')
+    }
+  },
+}))
+
+vi.mock('../src/cron/service.js', () => ({
+  CronService: class FakeCron {
+    constructor(_db: Database, _tickMs?: number, _now?: () => Date) {}
+    start(): void {
+      lifecycle.started.push('cron')
+    }
+    stop(): void {
+      lifecycle.stopped.push('cron')
+      if (lifecycle.cronStopError) throw lifecycle.cronStopError
+    }
+  },
+  cronMatches: () => false,
+}))
+
+vi.mock('../src/retention/service.js', () => ({
+  RetentionService: class FakeRetention {
+    constructor(_db: Database, _config?: RetentionConfig, _now?: () => Date) {}
+    start(): void {
+      lifecycle.started.push('retention')
+      throw new Error('retention start failure')
+    }
+    async stop(): Promise<void> {
+      lifecycle.stopped.push('retention')
+    }
+  },
+}))
+
+/** Wrap a real PGlite engine with a counted `close()`. */
+async function countedPgliteEngine(): Promise<DbEngine & { closeCount: () => number }> {
+  const base = await createPgliteEngine()
+  let count = 0
+  return {
+    query: base.query.bind(base),
+    exec: base.exec.bind(base),
+    transaction: base.transaction.bind(base),
+    listen: base.listen.bind(base),
+    close: async () => {
+      count++
+      await base.close()
+    },
+    closeCount: () => count,
+  }
+}
+
+describe('CLI start teardown', () => {
+  it('reports every owner cleanup failure to the caller and logger', async () => {
+    const serverFailure = new Error('forced server close failure')
+    const backendFailure = new Error('forced backend close failure')
+    const logged: unknown[][] = []
+    const serverClose = vi.fn().mockRejectedValue(serverFailure)
+    const backendClose = vi.fn().mockRejectedValue(backendFailure)
+    const teardownStart = createStartTeardown(
+      [
+        { name: 'server', close: serverClose },
+        { name: 'backend', close: backendClose },
+      ],
+      (...args) => logged.push(args)
+    )
+
+    const errors = await teardownStart()
+
+    expect(errors).toEqual([serverFailure, backendFailure])
+    expect(serverClose).toHaveBeenCalledOnce()
+    expect(backendClose).toHaveBeenCalledOnce()
+    expect(logged).toEqual([
+      ['cleanup of server failed:', serverFailure],
+      ['cleanup of backend failed:', backendFailure],
+    ])
+  })
+})
+
+describe('acquireEngineHandoff', () => {
+  const makeCountedEngine = (): {
+    engine: { close: () => Promise<void> }
+    closeCount: () => number
+  } => {
+    let count = 0
+    let closed = false
+    return {
+      engine: {
+        close: async () => {
+          count++
+          if (closed) return
+          closed = true
+        },
+      },
+      closeCount: () => count,
+    }
+  }
+
+  it('owns and closes an engine when shutdown starts during pending acquisition', async () => {
+    const { engine, closeCount } = makeCountedEngine()
+    const { promise: engineP, resolve: resolveEngine } = Promise.withResolvers<typeof engine>()
+    const handoff = acquireEngineHandoff(() => engineP)
+
+    const shutdownP = handoff.shutdown()
+    resolveEngine(engine)
+
+    expect(await handoff.engineP).toBe(engine)
+    expect(await shutdownP).toEqual([])
+    expect(closeCount()).toBe(1)
+    expect(await handoff.shutdown()).toEqual([])
+    expect(closeCount()).toBe(1)
+  })
+
+  it('closes a resolved engine exactly once when shutdown arrives afterward', async () => {
+    const { engine, closeCount } = makeCountedEngine()
+    const handoff = acquireEngineHandoff(async () => engine)
+
+    expect(await handoff.engineP).toBe(engine)
+    expect(closeCount()).toBe(0)
+    expect(await handoff.shutdown()).toEqual([])
+    expect(await handoff.shutdown()).toEqual([])
+    expect(closeCount()).toBe(1)
+  })
+})
+
+// ─── Engine-to-backend handoff regression ─────────────────────────────
+// `createStartHandoff` fires `createBackend` and exposes a `shutdown` that
+// always awaits the backend promise first. The contract:
+//   - On resolve, `shutdown()` closes the backend (the only owned resource).
+//   - On reject, `shutdown()` returns an empty error list (the factory
+//     already closed the engine via its own runCleanup, so no second-close
+//     is possible).
+//   - Repeated `shutdown()` calls share one memoized teardown, so the
+//     backend (and its underlying engine) is closed exactly once.
+// The handoff itself NEVER touches the engine directly — the factory owns
+// engine cleanup in every scenario. The four cases below prove this with
+// a counted fake engine: real factory behavior is modeled by closing the
+// engine inside the factory before throwing.
+describe('createStartHandoff engine→backend handoff', () => {
+  // Fake engine with a counted, idempotent `close()`: every call is
+  // recorded by the counter, then the first one performs the "work" and
+  // subsequent calls are no-ops. Counting attempts (not just successful
+  // closes) is how we detect a double-close: a buggy path that invokes
+  // engine.close() twice shows up as `closeCount === 2`, even though only
+  // one call actually closes anything. This matches the brief's "becomes a
+  // no-op on subsequent calls" requirement.
+  const makeCountedEngine = (): {
+    engine: { close: () => Promise<void> }
+    closeCount: () => number
+  } => {
+    let count = 0
+    let closed = false
+    return {
+      engine: {
+        close: async () => {
+          count++
+          if (closed) return
+          closed = true
+        },
+      },
+      closeCount: () => count,
+    }
+  }
+
+  it('successful createBackend: shutdown closes the backend, which closes the engine exactly once', async () => {
+    const { engine, closeCount } = makeCountedEngine()
+    // Real `TinbaseBackend.close()` cascades through db.close() → engine.close().
+    // The fake backend models that: closing the backend closes the engine.
+    let backendClosed = 0
+    const backend = {
+      close: async () => {
+        backendClosed++
+        await engine.close()
+      },
+    }
+    const handoff = createStartHandoff(async () => backend)
+    const result = await handoff.backendP
+    expect(result).toBe(backend)
+    // The handoff does not directly touch the engine — the factory owns
+    // the engine, and on success the factory transfers ownership into the
+    // backend (backend.close() → db.close() closes the engine).
+    expect(closeCount()).toBe(0)
+    const errors = await handoff.shutdown()
+    expect(errors).toEqual([])
+    // Engine closure is reached exactly once via backend.close().
+    expect(backendClosed).toBe(1)
+    expect(closeCount()).toBe(1)
+    // A second shutdown() is idempotent — the teardown promise is
+    // memoized, so the backend (and therefore the engine) is not closed twice.
+    const errors2 = await handoff.shutdown()
+    expect(errors2).toEqual([])
+    expect(backendClosed).toBe(1)
+    expect(closeCount()).toBe(1)
+  })
+
+  it('createBackend rejection (factory cleaned up): shutdown is a no-op, engine stays at 1', async () => {
+    const { engine, closeCount } = makeCountedEngine()
+    // Real `createBackend` behavior on init failure: its own runCleanup
+    // closes the engine exactly once before throwing. The handoff's
+    // shutdown() awaits the rejected promise and sees an empty error list
+    // (no second-close of the engine).
+    const handoff = createStartHandoff(async () => {
+      await engine.close()
+      throw new Error('forced init failure')
+    })
+    await expect(handoff.backendP).rejects.toThrow('forced init failure')
+    expect(closeCount()).toBe(1)
+    // The teardownStart called by `runStartSafely`'s catch sees a no-op
+    // shutdown — engine stays at 1.
+    expect(await handoff.shutdown()).toEqual([])
+    expect(closeCount()).toBe(1)
+    // A repeat shutdown is also a no-op.
+    expect(await handoff.shutdown()).toEqual([])
+    expect(closeCount()).toBe(1)
+  })
+
+  it('signal during pending acquisition (factory rejects after engine cleanup): no double-close', async () => {
+    const { engine, closeCount } = makeCountedEngine()
+    // The factory stays pending until the test resolves it, simulating a
+    // long-running createBackend (e.g. a slow native engine probe). A
+    // signal arrives mid-acquisition — `shutdown()` awaits the still-
+    // pending backendP and will only close resources once the factory
+    // settles, so the shutdown does not race the factory against a
+    // half-closed engine.
+    const { promise: factory, reject: rejectFactory } = Promise.withResolvers<{ close: () => Promise<void> }>()
+    const handoff = createStartHandoff(() => factory)
+    const shutdownPromise = handoff.shutdown()
+    // Yield so shutdown's await backendP is registered before we reject.
+    await Promise.resolve()
+    expect(closeCount()).toBe(0)
+    // Factory rejects AFTER cleaning up the engine — mirrors real
+    // createBackend's runCleanup-then-throw contract.
+    await engine.close()
+    rejectFactory(new Error('late factory rejection after engine cleanup'))
+    // shutdown() resolves to an empty error list (factory already cleaned up).
+    expect(await shutdownPromise).toEqual([])
+    expect(closeCount()).toBe(1)
+    await expect(handoff.backendP).rejects.toThrow('late factory rejection after engine cleanup')
+    // A repeat shutdown remains a no-op.
+    expect(await handoff.shutdown()).toEqual([])
+    expect(closeCount()).toBe(1)
+  })
+
+  it('signal during pending acquisition (factory resolves to backend): shutdown closes backend, which closes engine exactly once', async () => {
+    const { engine, closeCount } = makeCountedEngine()
+    let backendClosed = 0
+    const backend = {
+      close: async () => {
+        backendClosed++
+        await engine.close()
+      },
+    }
+    const { promise: factory, resolve: resolveFactory } = Promise.withResolvers<{ close: () => Promise<void> }>()
+    const handoff = createStartHandoff(() => factory)
+    const shutdownPromise = handoff.shutdown()
+    await Promise.resolve()
+    // Factory resolves with a backend; shutdown's await backendP unblocks
+    // and closes the backend (and therefore the engine) exactly once.
+    resolveFactory(backend)
+    expect(await shutdownPromise).toEqual([])
+    expect(backendClosed).toBe(1)
+    expect(closeCount()).toBe(1)
+    expect(await handoff.backendP).toBe(backend)
+    // A repeat shutdown is idempotent.
+    expect(await handoff.shutdown()).toEqual([])
+    expect(backendClosed).toBe(1)
+    expect(closeCount()).toBe(1)
+  })
+})
+
+// ─── Start acquisition gate (signal-during-createBackend) ────────────────
+// Regression for the advisory: a SIGINT/SIGTERM that arrives during
+// createBackend's pending window sets `shuttingDown = true` (synchronously,
+// before teardownStart is awaited) and the handoff's `shutdown()` runs the
+// backend-only cleanup. The main path's `await backendP` then unblocks,
+// and without a gate it would continue past `serve(...)` — acquiring a
+// server that no teardown can ever reach. `runStartGate` (cli.ts) throws
+// `ShutdownDuringStartup` so `runStartSafely`'s catch awaits the memoized
+// `teardownStart` (a no-op on second call) and rethrows, exiting the
+// process non-zero without ever starting the server.
+describe('start acquisition gate', () => {
+  it('returns silently when no signal arrived', () => {
+    expect(() => runStartGate({wasShuttingDown: false})).not.toThrow()
+  })
+
+  it('throws ShutdownDuringStartup when shuttingDown is true', () => {
+    expect(() => runStartGate({wasShuttingDown: true})).toThrow(ShutdownDuringStartup)
+  })
+
+  // The deferred-backend concurrency case the brief calls out:
+  //   1. construct a slow `createBackend` factory (resolves only when a
+  //      deferred is resolved);
+  //   2. `createStartHandoff(factory)`, capture `backendP`;
+  //   3. concurrently invoke `handoff.shutdown()` WITHOUT resolving the
+  //      deferred, then immediately resolve the deferred;
+  //   4. verify cleanup happens at most once and the resolved backend
+  //      never gets a second close;
+  //   5. also assert no server.start() ever runs: the gate must abort
+  //      before the would-be serve() call.
+  //
+  // Ordering mirrors real `onSignal` (cli.ts:324): `shuttingDown` is set
+  // synchronously BEFORE awaiting teardownStart. Setting it in

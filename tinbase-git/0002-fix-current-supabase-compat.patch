+/**
+ * Handoff state for the `start` path: `createBackend` is fired, and
+ * ownership of any acquired engine transfers from the handoff into the
+ * factory. The handoff itself never touches the engine — engine cleanup
+ * is the factory's sole responsibility.
+ *
+ * The factory contract:
+ *   - On success, the factory transfers engine ownership to the backend
+ *     (`backend.close()` → `db.close()` closes the engine). The handoff's
+ *     `shutdown()` reaches the engine via that path.
+ *   - On failure, the factory has already run its own internal
+ *     `runCleanup`, closing the engine exactly once. The handoff's
+ *     `shutdown()` is then a no-op.
+ *
+ * The handoff's `shutdown()` always awaits the backend promise first:
+ *   - on resolve, closes the backend;
+ *   - on reject, returns an empty error list (the factory already cleaned
+ *     up, so no second-close is possible).
+ *
+ * Exported for unit testing: `test/backend-lifecycle.test.ts` drives this
+ * state machine with fake engines/backends to prove the double-close is
+ * impossible.
+ */
+export type StartHandoff<B> = {
+  /** Resolves to the backend on success, rejects with the factory's error. */
+  readonly backendP: Promise<B>
+  /**
+   * Current owner's cleanup. Always awaits `backendP` first:
+   *   - on resolve, closes the backend (the only owned resource);
+   *   - on reject, the factory already closed the engine via its own
+   *   runCleanup, so shutdown is a no-op (returns an empty error list).
+   *
+   * The teardown promise is memoized, so repeated `shutdown()` calls
+   * share one idempotent teardown — the backend (and its underlying
+   * engine) is closed exactly once.
+   */
+  readonly shutdown: () => Promise<Error[]>
+}
+export const createStartHandoff = <B extends { close: () => Promise<void> }>(createBackend: () => Promise<B>): StartHandoff<B> => {
+  // Wrap createBackend in a resolved promise so a synchronous factory throw
+  // is normalized into a backendP rejection (matches the brief's
+  // "wrapped in a resolved promise" requirement). createStartHandoff
+  // returns synchronously, so the caller can install owner.shutdown before
+  // any factory work begins.
+  const backendP: Promise<B> = Promise.resolve().then(() => createBackend())
+  // Split the outcome into a closure that, when called once, runs the
+  // backend teardown and caches its promise. We never directly close the
+  // engine here — engine cleanup is the factory's responsibility, so this
+  // handoff cannot race the factory against a half-closed engine.
+  let backendTeardownPromise: Promise<Error[]> | undefined
+  let backendTeardown: (() => Promise<Error[]>) | undefined
+  backendP.then(
+    (b) => {
+      backendTeardown = () => {
+        if (backendTeardownPromise) return backendTeardownPromise
+        backendTeardownPromise = createStartTeardown([{ name: 'backend', close: () => b.close() }])()
+        return backendTeardownPromise
       }
-    }
-    await backend.close()
-    return
+    },
+    () => { /* rejection path: factory already cleaned up, nothing to do */ }
+  )
+  return {
+    backendP,
+    shutdown: async () => {
+      try {
+        await backendP
+      } catch {
+        // Factory already ran its own cleanup (engine closed exactly once
+        // inside the factory's runCleanup). No second-close.
+        return []
+      }
+      if (!backendTeardown) return []
+      return backendTeardown()
+    },
   }

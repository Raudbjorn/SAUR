index 0000000..3c480c1
--- /dev/null
+++ b/src/node/http-cache.ts
@@ -0,0 +1,158 @@
+/**
+ * Disk cache for immutable HTTP responses (JSR version metadata and the
+ * esbuild http-url loader's source bodies).
+ *
+ * Two layers:
+ *   - an in-process `Map<string, string>` fronting the disk so the same URL
+ *     hit repeatedly in a single bundler invocation never re-reads the file;
+ *   - a file under `tmpdir()/tinbase-fn-http` keyed by `sha256(url)`.
+ *
+ * Only safe for content whose URL is immutable for the file's lifetime (a
+ * versioned package metadata file, the resolved importer URL of an esm.sh
+ * source). Mutable package metadata (`{origin}/@scope/name/meta.json`) MUST
+ * NOT flow through this helper — the freshness contract there is "always
+ * fetch".
+ *
+ * Test injection: pass a custom `DiskCache` to bypass the real filesystem so
+ * tests asserting call counts don't have stale tmpdir entries masking the
+ * fake fetch. With an injected cache, `readFromDiskCache` is a hit when the
+ * in-memory fronting map has a value; `writeToDiskCache` only updates that
+ * map. This mirrors the existing `fetchImpl` injection in
+ * `bundle-function.ts`.
+ */
+import { createHash, randomBytes } from 'node:crypto'
+import { mkdir, readFile, rename, rm, writeFile } from 'node:fs/promises'
+import { existsSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+
+/** The directory used by both the loader and the JSR resolver. */
+export const HTTP_CACHE_DIR = join(tmpdir(), 'tinbase-fn-http')
+
+/**
+ * Minimal disk-cache surface used by the JSR resolver and the http-url
+ * loader. Tests can inject a fresh in-memory `DiskCache` to keep call-count
+ * assertions deterministic. Production callers use the module-level default
+ * singleton (exposed as named `readFromDiskCache` / `writeToDiskCache`
+ * functions) so that one bundler invocation hitting the same URL many times
+ * only ever issues a single disk roundtrip per URL.
+ *
+ * The resolver-and-loader code MUST NOT use this helper for mutable
+ * package metadata (`{origin}/@scope/name/meta.json`): that path always
+ * fetches. The helper is for content whose URL is immutable for the
+ * cache file's lifetime.
+ */
+export interface DiskCache {
+  /** Returns the cached body for `url`, or `null` on a miss. */
+  readFromDiskCache(url: string): Promise<string | null>
+  /** Stores `body` under the cache key for `url`. Atomic on disk. */
+  writeToDiskCache(url: string, body: string): Promise<void>
+}
+
+/** sha256(url) — the cache key. Hex digest, lowercase, 64 chars. */
+export const cacheKeyFor = (url: string): string =>
+  createHash('sha256').update(url).digest('hex')
+
+/**
+ * Log a best-effort warning when the on-disk cache fails. Kept as a small
+ * indirection so the resolver and loader don't each duplicate the format,
+ * and so tests can capture the call to assert the cache failure was
+ * downgraded to a miss / no-op rather than propagated.
+ */
+const warnCache = (action: 'read' | 'write', url: string, cause: unknown): void => {
+  const message = cause instanceof Error ? cause.message : String(cause)
+  console.warn(
+    `tinbase-fn-http: ${action} cache failure for ${url}: ${message} (continuing without cache)`,
+  )
+}
+
+/** Build a `DiskCache` closed over the given in-memory fronting map. */
+const makeDiskCache = (memory: Map<string, string>): DiskCache => ({
+  async readFromDiskCache(url: string): Promise<string | null> {
+    const key = cacheKeyFor(url)
+    const inMemory = memory.get(key)
+    if (inMemory !== undefined) return inMemory
+    const path = join(HTTP_CACHE_DIR, key)
+    if (!existsSync(path)) return null
+    // Cache I/O is best-effort: a read failure (EACCES, EIO, corrupt file,
+    // unwritable tmpdir) must NEVER abort bundling. The resolver and loader
+    // already handle a null hit by falling through to the network, so we
+    // downgrade the failure to a miss and warn. The bad-cache-recovery
+    // regression relies on this — if the in-memory fronting map is empty
+    // and the on-disk file is unreadable, the next resolution must reach
+    // the network.
+    let body: string
+    try {
+      body = await readFile(path, 'utf8')
+    } catch (cause) {
+      warnCache('read', url, cause)
+      return null
+    }
+    memory.set(key, body)
+    return body
+  },
+  async writeToDiskCache(url: string, body: string): Promise<void> {
+    const key = cacheKeyFor(url)
+    // Atomic write: write to a uniquely-named temp file in the same
+    // directory, then `rename` over the final path. A crashed or aborted
+    // write leaves at most one orphan temp file and the final path is
+    // either the prior valid contents or absent — never a half-written
+    // body.
+    //
+    // Cache writes are best-effort: an unwritable tmpdir must NOT abort
+    // bundling. We log a warning and continue. Whether the disk write
+    // succeeded or not, the in-memory fronting map is updated so the
+    // current process keeps a working cache for the rest of its
+    // lifetime; the next read in this process will hit the map and
+    // skip the disk layer entirely.
+    const finalPath = join(HTTP_CACHE_DIR, key)
+    const tempPath = join(HTTP_CACHE_DIR, `${key}.${randomBytes(8).toString('hex')}.tmp`)
+    try {
+      await mkdir(HTTP_CACHE_DIR, { recursive: true })
+      await writeFile(tempPath, body)
+      await rename(tempPath, finalPath)
+    } catch (cause) {
+      warnCache('write', url, cause)
+      // Clean up the orphan temp file if it exists; ignore secondary
+      // failures so we don't double-warn.
+      try {
+        await rm(tempPath, { force: true })
+      } catch {}
+      memory.set(key, body)
+      return
+    }
+    memory.set(key, body)
+  },
+})
+
+/**
+ * Build a fresh `DiskCache` that does NOT share state with the module
+ * default. Tests use this to keep state isolated between cases.
+ */
+export const createDiskCache = (): DiskCache => {
+  const memory = new Map<string, string>()
+  return makeDiskCache(memory)
+}
+
+/** The process-wide default. Shared with the named free functions below. */
+const defaultMemory = new Map<string, string>()
+const defaultDiskCacheImpl = makeDiskCache(defaultMemory)
+/** Named free functions backed by the module-level default instance. */
+export const readFromDiskCache = (url: string): Promise<string | null> =>
+  defaultDiskCacheImpl.readFromDiskCache(url)
+
+export const writeToDiskCache = (url: string, body: string): Promise<void> =>
+  defaultDiskCacheImpl.writeToDiskCache(url, body)
+
+/**
+ * Default on-disk cache, shared with the named free functions. The
+ * JSR resolver (when no `cache` option is supplied) goes through this so
+ * a process that resolves many specifiers shares one memory fronting
+ * map. The bundler does NOT use this default — `bundleFunction` calls
+ * `createDiskCache()` per invocation so each bundle is isolated from
+ * concurrent function loads in the same process.
+ */
+export const defaultDiskCache: DiskCache = defaultDiskCacheImpl
+
+
+

+++ b/src/node/import-map.ts
@@ -0,0 +1,139 @@
+/**
+ * Discover and resolve Deno/Supabase function-local import maps.
+ *
+ * Precedence beside a function directory: deno.json → deno.jsonc → import_map.json.
+ * Exact keys match only exactly; slash-suffixed keys use longest-prefix matching.
+ * Relative mapped targets resolve against the map file directory. Remote targets
+ * (npm:, jsr:, http(s):) are returned unchanged for the remote resolver layer.
+ */
+import { access, readFile } from 'node:fs/promises'
+import { dirname, resolve } from 'node:path'
+import { parse as parseJsonc, type ParseError } from 'jsonc-parser'
+import { type ProbeResult, type Result } from './result.js'
+export type { ProbeResult, Result } from './result.js'
+
+export interface ImportMap {
+  /** Absolute path of the discovered config file. */
+  readonly path: string
+  /** Validated string-to-string imports table. Treated as immutable by callers. */
+  readonly imports: Readonly<Record<string, string>>
+}
+
+const CONFIG_NAMES = ['deno.json', 'deno.jsonc', 'import_map.json'] as const
+
+const probe = async (path: string): Promise<ProbeResult> => {
+  try {
+    await access(path)
+    return { ok: true, exists: true }
+  } catch (err) {
+    const code = (err as NodeJS.ErrnoException).code
+    if (code === 'ENOENT') return { ok: true, exists: false }
+    const message = err instanceof Error ? err.message : String(err)
+    return { ok: false, error: `access ${path}: ${message}` }
+  }
+}
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+function validateImports(raw: unknown, configPath: string): Result<Record<string, string>> {
+  if (raw === undefined) return { ok: true, value: {} }
+  if (!isPlainObject(raw)) {
+    return { ok: false, error: `invalid imports in ${configPath}: expected an object` }
+  }
+  const imports: Record<string, string> = {}
+  for (const [key, value] of Object.entries(raw)) {
+    if (typeof value !== 'string') {
+      return {
+        ok: false,
+        error: `invalid imports in ${configPath}: mapping for "${key}" must be a string`,
+      }
+    }
+    imports[key] = value
+  }
+  return { ok: true, value: imports }
+}
+
+/**
+ * Load the highest-precedence import map beside `functionDir`.
+ * Returns `{ ok: true, value: null }` when no config file exists.
+ */
+export async function loadImportMap(functionDir: string): Promise<Result<ImportMap | null>> {
+  let configPath: string | null = null
+  for (const name of CONFIG_NAMES) {
+    const candidate = resolve(functionDir, name)
+    const found = await probe(candidate)
+    if (!found.ok) return found
+    if (found.exists) {
+      configPath = candidate
+      break
+    }
+  }
+  if (!configPath) return { ok: true, value: null }
+
+  let text: string
+  try {
+    text = await readFile(configPath, 'utf8')
+  } catch (err) {
+    const message = err instanceof Error ? err.message : String(err)
+    return { ok: false, error: `failed to read import map ${configPath}: ${message}` }
+  }
+
+  const errors: ParseError[] = []
+  const parsed = parseJsonc(text, errors, { allowTrailingComma: true })
+  if (errors.length > 0) {
+    return { ok: false, error: `failed to parse import map ${configPath}` }
+  }
+  if (!isPlainObject(parsed)) {
+    return { ok: false, error: `invalid import map ${configPath}: expected a JSON object` }
+  }
+
+  const importsResult = validateImports(parsed.imports, configPath)
+  if (!importsResult.ok) return importsResult
+
+  return { ok: true, value: { path: configPath, imports: importsResult.value } }
+}
+
+function isRemoteSpecifier(target: string): boolean {
+  return (
+    target.startsWith('npm:') ||
+    target.startsWith('jsr:') ||
+    target.startsWith('http://') ||
+    target.startsWith('https://')
+  )
+}
+
+function materializeTarget(mapPath: string, target: string): string {
+  if (isRemoteSpecifier(target)) return target
+  return resolve(dirname(mapPath), target)
+}
+
+/**
+ * Resolve `specifier` against a loaded import map.
+ * Unmapped bare specifiers return `{ ok: false, error }` including the original name.
+ */
+export function resolveImportSpecifier(map: ImportMap, specifier: string): Result<string> {
+  const exact = map.imports[specifier]
+  if (exact !== undefined) {
+    return { ok: true, value: materializeTarget(map.path, exact) }
+  }
+
+  let bestKey: string | null = null
+  for (const key of Object.keys(map.imports)) {
+    if (!key.endsWith('/')) continue
+    if (!specifier.startsWith(key)) continue
+    if (bestKey === null || key.length > bestKey.length) bestKey = key
+  }
+
+  if (bestKey !== null) {
+    const prefixTarget = map.imports[bestKey]!
+    const remainder = specifier.slice(bestKey.length)
+    if (isRemoteSpecifier(prefixTarget)) {
+      return { ok: true, value: prefixTarget + remainder }
+    }
+    return { ok: true, value: resolve(dirname(map.path), prefixTarget, remainder) }
+  }
+
+  return { ok: false, error: `unmapped import specifier: ${specifier}` }
+}

@@ -0,0 +1,345 @@
+/**
+ * Resolve `jsr:` specifiers via JSR package and version metadata.
+ *
+ * Mutable package metadata is always fetched fresh. Immutable version metadata
+ * may be cached by fully resolved version URL. Specifiers are never rewritten
+ * through esm.sh.
+ */
+import { maxSatisfying, valid } from 'semver'
+import { defaultDiskCache, type DiskCache } from './http-cache.js'
+import type { Result } from './result.js'
+export type { Result } from './result.js'
+
+/**
+ * JSR registry fetches must not hang an edge-function start indefinitely
+ * when the registry or a mirror is unresponsive. The default below fits
+ * normal cold-cache first-fetch latency against `jsr.io` while still
+ * aborting well inside the 30s gateway-typical idle window. Callers can
+ * override via `ResolveJsrOptions.fetchTimeoutMs` (e.g. tests pin it to a
+ * few ms to assert the abort path quickly without hitting vitest's 5s
+ * default test-timeout budget). The constant is exported so tests can
+ * guard the documented value against silent drift.
+ */
+export const DEFAULT_FETCH_TIMEOUT_MS = 10_000
+
+export const JSR_REGISTRY_ORIGIN = 'https://jsr.io'
+export const TINBASE_USER_AGENT = 'tinbase/0.10.0'
+
+export type JsrFetch = (input: string, init?: RequestInit) => Promise<Response>
+
+export interface ParsedJsrSpecifier {
+  readonly scope: string
+  readonly name: string
+  readonly constraint: string | null
+  readonly subpath: string | null
+}
+
+export type JsrModuleKind = 'source' | 'declaration'
+
+export interface ResolvedJsrModule {
+  readonly url: string
+  readonly version: string
+  readonly kind: JsrModuleKind
+}
+
+export interface ResolveJsrOptions {
+  readonly fetch?: JsrFetch
+  /**
+   * Legacy test-injection front. ACCEPTED for call-shape compatibility
+   * with the existing tests but IGNORED for the immutable version
+   * metadata URL — callers that need to control the cache must use
+   * `diskCache` below.
+   */
+  readonly cache?: Map<string, string>
+  /**
+   * Injected `DiskCache` for the version metadata URL. When omitted,
+   * a module-level default on-disk cache is used (see `./http-cache.ts`).
+   * Bundlers pass their shared on-disk cache so a process that resolves
+   * many `jsr:` specifiers amortises one disk roundtrip per URL per
+   * process. Tests inject a Map-only `DiskCache` to keep call counts
+   * deterministic and avoid tmpdir state leaking across runs.
+   */
+  readonly diskCache?: DiskCache
+  readonly registryOrigin?: string
+  /**
+   * Abort the fetch after this many ms when it does not resolve. Defaults
+   * to `DEFAULT_FETCH_TIMEOUT_MS`. Pass a small value in tests to assert
+   * the abort path without bumping vitest's test-timeout.
+   */
+  readonly fetchTimeoutMs?: number
+}
+
+const JSR_SPEC_RE = /^jsr:@([^/@]+)\/([^/@]+)(?:@([^/]+))?(?:\/(.*))?$/
+
+export function parseJsrSpecifier(specifier: string): Result<ParsedJsrSpecifier> {
+  const match = JSR_SPEC_RE.exec(specifier)
+  if (!match) {
+    return { ok: false, error: `malformed jsr specifier: ${specifier || 'jsr:'}` }
+  }
+  const scope = match[1]!
+  const name = match[2]!
+  if (!scope || !name) {
+    return { ok: false, error: `malformed jsr specifier: ${specifier}` }
+  }
+  return {
+    ok: true,
+    value: {
+      scope,
+      name,
+      constraint: match[3] ?? null,
+      subpath: match[4] && match[4].length > 0 ? match[4] : null,
+    },
+  }
+}
+
+function packageMetaUrl(origin: string, scope: string, name: string): string {
+  return `${origin}/@${scope}/${name}/meta.json`
+}
+
+function versionMetaUrl(origin: string, scope: string, name: string, version: string): string {
+  return `${origin}/@${scope}/${name}/${version}_meta.json`
+}
+
+function sourceUrl(
+  origin: string,
+  scope: string,
+  name: string,
+  version: string,
+  exportPath: string
+): string {
+  const normalized = exportPath.replace(/^\.\//, '').replace(/^\//, '')
+  return `${origin}/@${scope}/${name}/${version}/${normalized}`
+}
+
+function exportKeyForSubpath(subpath: string | null): string {
+  if (!subpath) return '.'
+  return subpath.startsWith('./') ? subpath : `./${subpath}`
+}
+
+function moduleKindForPath(path: string): JsrModuleKind {
+  return path.endsWith('.d.ts') ? 'declaration' : 'source'
+}
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+interface PackageMeta {
+  latest: string
+  versions: Record<string, { yanked?: boolean }>
+}
+
+interface VersionMeta {
+  exports: Record<string, string>
+}
+
+function parsePackageMeta(raw: unknown, url: string): Result<PackageMeta> {
+  if (!isPlainObject(raw)) {
+    return { ok: false, error: `invalid JSR package metadata at ${url}: expected object` }
+  }
+  if (typeof raw.latest !== 'string' || raw.latest.length === 0) {
+    return { ok: false, error: `invalid JSR package metadata at ${url}: missing latest` }
+  }
+  if (!isPlainObject(raw.versions)) {
+    return { ok: false, error: `invalid JSR package metadata at ${url}: missing versions` }
+  }
+  const versions: Record<string, { yanked?: boolean }> = {}
+  for (const [version, info] of Object.entries(raw.versions)) {
+    if (info === undefined || info === null) {
+      versions[version] = {}
+      continue
+    }
+    if (!isPlainObject(info)) {
+      return {
+        ok: false,
+        error: `invalid JSR package metadata at ${url}: bad version entry ${version}`,
+      }
+    }
+    versions[version] = { yanked: info.yanked === true }
+  }
+  return { ok: true, value: { latest: raw.latest, versions } }
+}
+
+function parseVersionMeta(raw: unknown, url: string): Result<VersionMeta> {
+  if (!isPlainObject(raw) || !isPlainObject(raw.exports)) {
+    return { ok: false, error: `invalid JSR version metadata at ${url}: missing exports` }
+  }
+  const exports: Record<string, string> = {}
+  for (const [key, value] of Object.entries(raw.exports)) {
+    if (typeof value !== 'string') {
+      return {
+        ok: false,
+        error: `invalid JSR version metadata at ${url}: export "${key}" must be a string`,
+      }
+    }
+    exports[key] = value
+  }
+  return { ok: true, value: { exports } }
+}
+async function fetchText(
+  fetchImpl: JsrFetch,
+  url: string,
+  label: string,
+  timeoutMs: number,
+): Promise<Result<string>> {
+  // AbortSignal is built fresh per fetch so completed/aborted signals never
+  // leak between calls.
+  const signal = AbortSignal.timeout(timeoutMs)
+  let res: Response
+  try {
+    res = await fetchImpl(url, {
+      headers: { 'user-agent': TINBASE_USER_AGENT },
+      redirect: 'follow',
+      signal,
+    })
+  } catch (err) {
+    if (signal.aborted) {
+      return {
+        ok: false,
+        error: `failed to fetch JSR ${label} ${url}: timed out after ${timeoutMs}ms`,
+      }
+    }
+    const message = err instanceof Error ? err.message : String(err)
+    return { ok: false, error: `failed to fetch JSR ${label} ${url}: ${message}` }
+  }
+  if (!res.ok) {
+    return { ok: false, error: `failed to fetch JSR ${label} ${url}: HTTP ${res.status}` }
+  }
+  try {
+    return { ok: true, value: await res.text() }
+  } catch (err) {
+    if (signal.aborted) {
+      return {
+        ok: false,
+        error: `failed to read JSR ${label} ${url}: timed out after ${timeoutMs}ms`,
+      }
+    }
+    const message = err instanceof Error ? err.message : String(err)
+    return { ok: false, error: `failed to read JSR ${label} ${url}: ${message}` }
+  }
+}
+
+function parseJson(text: string, url: string): Result<unknown> {
+  try {
+    return { ok: true, value: JSON.parse(text) as unknown }
+  } catch {
+    return { ok: false, error: `failed to parse JSR JSON at ${url}` }
+  }
+}
+
+function selectVersion(meta: PackageMeta, constraint: string | null, label: string): Result<string> {
+  if (constraint === null) {
+    if (!(meta.latest in meta.versions)) {
+      return {
+        ok: false,
+        error: `JSR package ${label} latest version ${meta.latest} is missing from versions`,
+      }
+    }
+    return { ok: true, value: meta.latest }
+  }
+
+  const exact = valid(constraint)
+  if (exact) {
+    const info = meta.versions[exact]
+    if (!info) {
+      return { ok: false, error: `JSR package ${label} has no version ${exact}` }
+    }
+    if (info.yanked) {
+      return { ok: false, error: `JSR package ${label} version ${exact} is yanked` }
+    }
+    return { ok: true, value: exact }
+  }
+
+  const candidates = Object.entries(meta.versions)
+    .filter(([, info]) => !info.yanked)
+    .map(([version]) => version)
+  const selected = maxSatisfying(candidates, constraint)
+  if (!selected) {
+    return {
+      ok: false,
+      error: `JSR package ${label} has no non-yanked version satisfying ${constraint}`,
+    }
+  }
+  return { ok: true, value: selected }
+}
+
+/**
+ * Resolve a `jsr:` specifier to an immutable source URL and module kind.
+ */
+export async function resolveJsrSpecifier(
+  specifier: string,
+  options: ResolveJsrOptions = {}
+): Promise<Result<ResolvedJsrModule>> {
+  const parsed = parseJsrSpecifier(specifier)
+  if (!parsed.ok) return parsed
+
+  const origin = options.registryOrigin ?? JSR_REGISTRY_ORIGIN
+  const fetchImpl = options.fetch ?? fetch
+  // The `cache` option is the legacy test-injection front and is
+  // IGNORED for the immutable version metadata URL. Callers that
+  // need to control the cache must use `diskCache` (typed `DiskCache`)
+  // — typically a Map-only implementation in tests so call counts stay
+  // deterministic. The bundler passes its shared on-disk cache here.
+  const diskCache: DiskCache = options.diskCache ?? defaultDiskCache
+  const timeoutMs = options.fetchTimeoutMs ?? DEFAULT_FETCH_TIMEOUT_MS
+  const { scope, name, constraint, subpath } = parsed.value
+  const label = `@${scope}/${name}`
+
+  const pkgUrl = packageMetaUrl(origin, scope, name)
+  const pkgText = await fetchText(fetchImpl, pkgUrl, 'package metadata', timeoutMs)
+  if (!pkgText.ok) return pkgText
+  const pkgJson = parseJson(pkgText.value, pkgUrl)
+  if (!pkgJson.ok) return pkgJson
+  const pkgMeta = parsePackageMeta(pkgJson.value, pkgUrl)
+  if (!pkgMeta.ok) return pkgMeta
+
+  const versionResult = selectVersion(pkgMeta.value, constraint, label)
+  if (!versionResult.ok) return versionResult
+  const version = versionResult.value
+
+  const verUrl = versionMetaUrl(origin, scope, name, version)
+  const diskHit = await diskCache.readFromDiskCache(verUrl)
+  let verText: string
+  let fromCache: boolean
+  if (diskHit !== null) {
+    verText = diskHit
+    fromCache = true
+  } else {
+    fromCache = false
+    const fetched = await fetchText(fetchImpl, verUrl, 'version metadata', timeoutMs)
+    if (!fetched.ok) return fetched
+    verText = fetched.value
+  }
+  const verJson = parseJson(verText, verUrl)
+  if (!verJson.ok) return verJson
+  const verMeta = parseVersionMeta(verJson.value, verUrl)
+  if (!verMeta.ok) return verMeta
+
+  // Disk write only after BOTH parseJson and parseVersionMeta succeed.
+  // The bad-cache-recovery regression relies on this: a malformed
+  // response must NEVER poison the cache so the next valid response
+  // can recover. `writeToDiskCache` uses temp-file + rename to keep
+  // the file atomic on disk.
+  if (!fromCache) {
+    await diskCache.writeToDiskCache(verUrl, verText)
+  }
+
+  const exportKey = exportKeyForSubpath(subpath)
+  const exportPath = verMeta.value.exports[exportKey]
+  if (exportPath === undefined) {
+    return {
+      ok: false,
+      error: `JSR package ${label}@${version} has no export "${exportKey}" (requested ${subpath ?? '.'})`,
+    }
+  }
+
+  const url = sourceUrl(origin, scope, name, version, exportPath)
+  return {
+    ok: true,
+    value: {
+      url,
+      version,
+      kind: moduleKindForPath(exportPath),
+    },
+  }
+}

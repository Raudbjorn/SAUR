index 0000000..762f4d1
--- /dev/null
+++ b/src/node/result.ts
@@ -0,0 +1,27 @@
+/**
+ * Shared discriminated result for resolver layers.
+ *
+ * Both `ok` arms are `readonly` so a returned value cannot be mutated by a
+ * caller after the function has returned — the classic post-return mutation
+ * bug (assigning to `result.ok` or `result.value` after a check) becomes a
+ * compile error rather than a silent corruption.
+ */
+export type Result<T> =
+  | { readonly ok: true; readonly value: T }
+  | { readonly ok: false; readonly error: string }
+
+/**
+ * Probe result for filesystem existence checks that must distinguish
+ * "determinately absent" from "could not determine".
+ *
+ * `exists` is on the `ok` arm (not named `value`) so the ternary reads as a
+ * direct question — `probe.ok && probe.exists` — and so the type does not
+ * collide with the `Result<T>` shape used by other resolver layers. The
+ * `error` arm is reserved for access failures that are NOT the expected
+ * absence case (EACCES, ENOTDIR, EMFILE, EIO, ...); ENOENT collapses to
+ * `{ ok: true, exists: false }` so callers can keep treating "absent" as a
+ * normal, recoverable control-flow signal.
+ */
+export type ProbeResult =
+  | { readonly ok: true; readonly exists: boolean }
+  | { readonly ok: false; readonly error: string }
